<view class="picker-root">
  <view class="recipe-search picker-search">
    <view class="search-mark" aria-hidden="true"></view>
    <input class="recipe-search-input" value="{{search}}" bindinput="searchChoices" confirm-type="search" placeholder="搜菜名或食材" aria-label="搜索"/>
    <button wx:if="{{search}}" class="link picker-clear" bindtap="clearSearch" aria-label="清除搜索">×</button>
  </view>

  <view class="picker-scenes">
    <button wx:for="{{sceneTags}}" wx:key="*this" class="picker-scene {{tagIndex === index ? 'is-active' : ''}}" data-index="{{index}}" bindtap="selectSceneTag" aria-pressed="{{tagIndex === index}}">{{item}}</button>
  </view>

  <view class="row picker-toolbar">
    <text class="section">{{search || categoryIndex || tagIndex || methodIndex ? '找到 ' : '共 '}}{{resultCount}} 道菜</text>
    <view class="picker-filters">
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="changeCategory" aria-label="{{'菜谱分类，当前' + categories[categoryIndex]}}">
        <view class="picker-filter {{categoryIndex ? 'is-active' : ''}}"><text>{{categories[categoryIndex]}}</text><view class="picker-caret" aria-hidden="true"></view></view>
      </picker>
      <picker mode="selector" range="{{methodTags}}" value="{{methodIndex}}" bindchange="changeCookMethod" aria-label="{{'烹饪方式，当前' + methodTags[methodIndex]}}">
        <view class="picker-filter {{methodIndex ? 'is-active' : ''}}"><text>{{methodTags[methodIndex]}}</text><view class="picker-caret" aria-hidden="true"></view></view>
      </picker>
    </view>
  </view>

  <view wx:if="{{!choices.length}}" class="empty">
    <view>没有找到符合条件的菜谱</view>
    <button wx:if="{{categoryIndex || tagIndex || methodIndex}}" class="link" bindtap="clearFilters">清除筛选</button>
  </view>
  <view wx:else class="picker-grid">
    <button wx:for="{{choices}}" wx:key="id" class="picker-choice {{checked[item.id] ? 'is-selected' : ''}}" bindtap="selectChoice" data-id="{{item.id}}" aria-pressed="{{!!checked[item.id]}}" hover-class="card-pressed">
      <recipe-cover class="picker-cover" src="{{item.image}}" lazy="{{true}}"/>
      <view class="picker-copy">
        <view class="picker-name">{{item.title}}</view>
        <view wx:if="{{item.note}}" class="subtle picker-note">{{item.note}}</view>
      </view>
      <view class="picker-indicator" aria-hidden="true">{{checked[item.id] ? '✓' : ''}}</view>
    </button>
  </view>
  <button wx:if="{{hasMore}}" class="link picker-load" bindtap="loadMore">加载更多</button>

  <view class="picker-footer">
    <view class="picker-footer-inner">
      <view class="picker-summary">
        <text class="subtle">{{selected.length ? '已选 ' + selected.length + ' 道菜' : (single ? '选一道替换菜谱' : '可以选择多道菜')}}</text>
        <scroll-view wx:if="{{selected.length}}" class="picker-selection" scroll-x="{{true}}">
          <view class="picker-selection-track">
            <button wx:for="{{selected}}" wx:key="id" class="picker-chip" data-id="{{item.id}}" bindtap="selectChoice" disabled="{{busy}}" aria-label="{{'取消选择' + item.title}}">
              <text>{{item.title}}</text><text aria-hidden="true">×</text>
            </button>
          </view>
        </scroll-view>
      </view>
      <button class="primary picker-confirm" bindtap="confirm" disabled="{{!selected.length || busy}}" loading="{{busy}}">{{confirmText}}</button>
    </view>
  </view>
</view>

:host { display: block; }
.cover, .placeholder { display: block; width: 100%; height: 100%; }
.cover-fluid { height: auto; }
.placeholder { display: flex; align-items: center; justify-content: center; background: var(--theme-placeholder, #f4e5d7); }
.placeholder image { width: 42rpx; height: 42rpx; }

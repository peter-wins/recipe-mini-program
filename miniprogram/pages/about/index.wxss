.about-page { min-height: 100vh; box-sizing: border-box; }
.about-inner { max-width: 900rpx; margin: 0 auto; padding: 0 var(--sp-8, 32rpx) 80rpx; box-sizing: border-box; }

.about-hero { display: flex; flex-direction: column; align-items: center; padding: 64rpx 0 44rpx; }
.about-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: var(--r-xl, 36rpx);
  background: var(--theme-neutral, #f1e6d9);
}
.about-logo image { width: 62rpx; height: 62rpx; }
.about-name { margin-top: 26rpx; color: var(--theme-text, #4e342c); font-size: var(--fs-2xl, 44rpx); font-weight: 700; }
.about-slogan { margin-top: 10rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); }

.about-card {
  margin-top: 20rpx;
  padding: 12rpx 28rpx 28rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.about-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; }
.about-row-label { color: var(--theme-muted, #75665e); font-size: var(--fs-md, 28rpx); }
.about-row-value { color: var(--theme-text, #4e342c); font-size: var(--fs-md, 28rpx); font-weight: 700; }

.about-section-title {
  margin-top: 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--theme-border, #f0e4d8);
  color: var(--theme-text, #4e342c);
  font-size: var(--fs-md, 28rpx);
  font-weight: 700;
}
.about-section-first { margin-top: 0; padding-top: 22rpx; border-top: 0; }

.about-note {
  position: relative;
  padding: 12rpx 0 0 24rpx;
  color: var(--theme-muted, #75665e);
  font-size: var(--fs-sm, 24rpx);
  line-height: 1.7;
}
.about-note::before {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--theme-accent-text, #994017);
}

/* 二级入口行：和「我的」页同一套交互语言 */
.about-link {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  min-height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
  line-height: 1.3;
}
.about-link-title { flex-shrink: 0; color: var(--theme-text, #4e342c); font-size: var(--fs-md, 28rpx); }
.about-link-hint {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--theme-muted, #75665e);
  font-size: var(--fs-sm, 24rpx);
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}
.about-arrow { flex-shrink: 0; color: var(--theme-muted, #75665e); font-size: var(--fs-lg, 32rpx); }

.about-source-hint { margin-top: 6rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); }
.about-source { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 0; }
.about-source + .about-source { border-top: 1rpx solid var(--theme-border, #f0e4d8); }
.about-source-copy { flex: 1; min-width: 0; }
.about-source-name { display: block; color: var(--theme-text, #4e342c); font-size: var(--fs-md, 28rpx); font-weight: 600; }
.about-source-detail { display: block; margin-top: 4rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); line-height: 1.5; }
.about-source-copy-btn {
  flex-shrink: 0;
  min-height: 60rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--r-full, 999rpx);
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-accent-text, #994017);
  font-size: var(--fs-sm, 24rpx);
  line-height: 58rpx;
}


.about-footer { margin-top: 32rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); text-align: center; }

@import "../../styles/recipe-card.wxss";

.meal-toolbar { margin-bottom: 16rpx; gap: 12rpx; }
.meal-filters { display: flex; flex-shrink: 0; align-items: center; gap: 14rpx; }
.meal-filter {
  position: relative;
  padding: 0 2rpx;
  border-radius: 0;
  background: transparent;
  color: var(--theme-muted, #75665e);
  font-size: 25rpx;
  line-height: 72rpx;
  white-space: nowrap;
}
.meal-filter-active { color: var(--theme-accent-text, #994017); font-weight: 650; }
.meal-filter-active::before {
  position: absolute;
  right: 2rpx;
  bottom: 9rpx;
  left: 2rpx;
  height: 3rpx;
  background: currentColor;
  content: '';
}
.meal-card {
  margin-bottom: 14rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.meal-plan-title { font-size: 30rpx; font-weight: 700; line-height: 1.3; }
.meal-time { flex-shrink: 0; font-size: 24rpx; }
.meal-dishes { margin-top: 10rpx; }
.meal-dish {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 68rpx;
  padding: 4rpx 0;
  border-top: 1rpx solid var(--theme-border, #f0e4d8);
}
.meal-dish-cover {
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 56rpx;
  overflow: hidden;
  border-radius: 12rpx;
}
.meal-dish-name { flex: 1; min-width: 0; font-size: 26rpx; overflow-wrap: anywhere; }
.meal-dish-arrow { flex-shrink: 0; }
.meal-card-meta { align-items: flex-start; margin-top: 10rpx; padding-right: 16rpx; }
.meal-card-meta .recipe-stock { min-width: 0; margin-left: auto; text-align: right; }
.meal-rice { flex-shrink: 0; font-size: 23rpx; }
.meal-section-footer { gap: 10rpx; }
.meal-plan-note { font-size: 24rpx; }
.meal-toggle-plans { padding: 0; font-size: 25rpx; line-height: 64rpx; }
.meal-plan-empty { padding: 4rpx 0 12rpx; }
.meal-recipes-heading { margin: 32rpx 0 16rpx; }

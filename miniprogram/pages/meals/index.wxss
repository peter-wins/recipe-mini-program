.meal-intro { margin-bottom: 18rpx; }
.meal-filters { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.meal-filter { padding: 0 22rpx; border: 1rpx solid #f0e4d8; border-radius: 999rpx; background: #fff; font-size: 27rpx; line-height: 72rpx; }
.meal-filter.chosen { background: #ffe8d5; color: #994017; }
.meal-card { margin-bottom: 18rpx; padding: 22rpx; border: 1rpx solid #f0e4d8; border-radius: 20rpx; background: #fff; }
.meal-time { flex-shrink: 0; }
.meal-nutrition { padding: 14rpx 16rpx; border-radius: 12rpx; background: #fff2e5; }
.nutrition-summary { margin-bottom: 4rpx; color: #5D4037; font-size: 27rpx; font-weight: 650; }
.meal-status { margin: 8rpx 0 14rpx; color: #48613d; font-size: 25rpx; }
.meal-status.missing { color: #994017; }
.meal-dish { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; min-height: 76rpx; border-top: 1rpx solid #f0e4d8; }

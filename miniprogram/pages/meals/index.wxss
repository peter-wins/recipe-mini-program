@import "../../styles/recipe-card.wxss";

.meal-page { padding-top: 12rpx; }
.meal-hero { flex-wrap: wrap; align-items: center; gap: 12rpx; }
.meal-hero-copy { flex: 1 1 240rpx; }
.meal-hero-copy, .meal-card-copy { min-width: 0; }
.meal-page-title { font-size: var(--fs-3xl, 52rpx); font-weight: 700; line-height: 1.2; }
.meal-subtitle { margin-top: 7rpx; font-size: var(--fs-sm, 24rpx); }
.meal-add, .meal-buy {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--theme-border, #eadfce);
  border-radius: 999rpx;
  background: var(--theme-soft, #f8eadc);
  color: var(--theme-accent-text, #994017);
  font-size: var(--fs-sm, 24rpx);
  font-weight: 600;
  line-height: 1.3;
  white-space: nowrap;
}
.meal-goals {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  margin: 26rpx 0 20rpx;
  border-bottom: 1rpx solid var(--theme-border, #eadfce);
}
.meal-goals button {
  position: relative;
  padding: 0;
  background: transparent;
  border-radius: 0;
  color: var(--theme-muted, #75665e);
  font-size: var(--fs-md, 28rpx);
  line-height: 84rpx;
  white-space: nowrap;
}
.meal-goals .meal-goal-active { color: var(--theme-accent-text, #994017); font-weight: 700; }
.meal-goal-active::before {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
  content: '';
}
.meal-calendar-link {
  display: flex;
  flex-shrink: 0;
  align-self: flex-start;
  align-items: center;
  gap: 8rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--theme-selected-border, #d9b59a);
  border-radius: 20rpx;
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-accent-text, #994017);
  font-size: var(--fs-sm, 24rpx);
  font-weight: 600;
  line-height: 62rpx;
  white-space: nowrap;
}
.meal-calendar-icon { width: 27rpx; height: 27rpx; }
.meal-create-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 200rpx;
  margin: 0;
  padding: 0;
  border: 2rpx dashed var(--theme-selected-border, #d9b59a);
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-soft, #fff4ec);
  color: var(--theme-accent-text, #994017);
  font-size: var(--fs-md, 28rpx);
  font-weight: 400;
  line-height: 1.4;
}
.meal-create-icon {
  font-size: var(--fs-2xl, 44rpx);
  line-height: 1;
}
.meal-card {
  margin-bottom: 22rpx;
  padding: 23rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.meal-card-heading { align-items: flex-start; gap: 12rpx; }
.meal-plan-title { font-size: var(--fs-lg, 32rpx); font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
.meal-plan-meta { display: flex; flex-wrap: wrap; align-items: center; column-gap: 10rpx; row-gap: 2rpx; margin-top: 4rpx; }
.meal-plan-note { font-size: var(--fs-sm, 24rpx); }
.meal-card-stock { flex-shrink: 0; margin-top: 4rpx; margin-right: 10rpx; white-space: nowrap; }
.meal-card-menu { flex-shrink: 0; padding: 0 4rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-2xl, 44rpx); line-height: 60rpx; letter-spacing: 2rpx; text-align: right; }
.meal-dishes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 17rpx; }
.meal-dishes-single { grid-template-columns: minmax(0, 1fr); }
.meal-dish { display: block; min-width: 0; border-radius: 16rpx; }
.meal-swap-hint { margin-top: 14rpx; color: var(--theme-accent-text, #994017); font-size: var(--fs-sm, 24rpx); }
.meal-swap-hint + .meal-dishes { margin-top: 8rpx; }
.meal-dish-swap { width: 100%; margin: 0; padding: 6rpx; border: 1rpx solid var(--theme-selected-border, #e6c5ad); background: var(--theme-selected, #fbecdc); text-align: left; line-height: 1.4; }
.meal-dish-swap .meal-dish-name { margin: 8rpx 4rpx 5rpx; }
.meal-dish-cover { display: block; height: 178rpx; overflow: hidden; border-radius: 16rpx; }
.meal-dishes-single .meal-dish-cover { height: 226rpx; }
.meal-photo-empty { display: flex; align-items: center; justify-content: center; background: var(--theme-placeholder, #f4e5d7); }
.meal-photo-empty image { width: 44rpx; height: 44rpx; }
.meal-dish-name { display: block; margin-top: 7rpx; font-size: var(--fs-sm, 24rpx); overflow-wrap: anywhere; }
.meal-card-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
  min-height: 80rpx;
  margin-top: 15rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--theme-border, #f0e4d8);
}
.meal-card-actions button { margin: 0; }
.meal-card-actions .meal-swap { margin-right: auto; padding: 0 10rpx 0 0; font-size: var(--fs-sm, 24rpx); white-space: nowrap; }
.meal-add, .meal-buy { min-height: 88rpx; }
.meal-add { border-color: transparent; }
.meal-buy { background: var(--theme-surface, #fff); }
.meal-toggle-plans {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  margin: 0;
  border: 1rpx solid var(--theme-selected-border, #e6c5ad);
  border-radius: 20rpx;
  background: var(--theme-selected, #fbecdc);
  color: var(--theme-accent-text, #994017);
  font-size: var(--fs-md, 28rpx);
  font-weight: 600;
  line-height: 80rpx;
}
.meal-expand-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-top: -5rpx;
  border: solid currentColor;
  border-width: 0 2rpx 2rpx 0;
  transform: rotate(45deg);
}
.meal-expand-arrow-up { margin-top: 5rpx; transform: rotate(225deg); }
.meal-sheet-overlay { position: fixed; inset: 0; z-index: 20; display: flex; align-items: flex-end; justify-content: center; }
.meal-sheet-backdrop { position: absolute; inset: 0; background: rgba(41, 26, 20, .38); }
.meal-sheet {
  position: relative;
  width: 100%;
  max-width: 900rpx;
  box-sizing: border-box;
  padding: 32rpx 30rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: var(--theme-surface, #fff);
}
.meal-sheet-note { margin-top: 5rpx; }
.meal-purchase-list { max-height: 44vh; margin-top: 14rpx; }
.meal-purchase-item { padding: 14rpx 0; border-bottom: 1rpx solid var(--theme-border, #f0e4d8); }
.meal-purchase-row { align-items: flex-start; gap: 16rpx; font-size: var(--fs-md, 28rpx); overflow-wrap: anywhere; }
.meal-purchase-row text + text { max-width: 55%; text-align: right; }
.meal-sheet-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 22rpx; }

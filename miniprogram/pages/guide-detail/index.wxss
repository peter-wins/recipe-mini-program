.detail-hero {
  position: relative;
  height: 300rpx;
  margin-top: 20rpx;
  border-radius: var(--card-radius, 28rpx);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.detail-hero .detail-hero-cover { width: 100%; height: 100%; }
.detail-season {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--theme-surface, #fff);
  color: var(--theme-accent-text, #783414);
  font-size: var(--fs-xs, 22rpx);
}
.detail-pending {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-muted, #75665e);
  font-size: var(--fs-sm, 24rpx);
  line-height: 1.6;
}
.detail-card {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.detail-row { display: flex; align-items: flex-start; gap: 14rpx; }
.detail-row + .detail-row { margin-top: 16rpx; }
.detail-tag {
  flex: 0 0 auto;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  color: var(--theme-surface, #fff);
  font-size: var(--fs-xs, 22rpx);
  line-height: 1.5;
}
.detail-tag-therapy { background: var(--theme-accent-text, #BA7517); }
.detail-tag-audience { background: var(--theme-accent-solid, #c24610); }
.detail-row-text { flex: 1; min-width: 0; color: var(--theme-muted, #67554c); font-size: var(--fs-md, 28rpx); line-height: 1.6; }
.detail-heading { margin-top: 28rpx; margin-bottom: 12rpx; color: var(--theme-text, #5d4037); font-size: var(--fs-lg, 32rpx); font-weight: 700; }
.detail-heading-row { display: flex; align-items: baseline; justify-content: space-between; }
.detail-count { color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); font-weight: 400; }
.detail-list-item { position: relative; padding-left: 24rpx; color: var(--theme-muted, #67554c); font-size: var(--fs-md, 28rpx); line-height: 1.7; }
.detail-list-item + .detail-list-item { margin-top: 8rpx; }
.detail-list-item::before { content: ''; position: absolute; left: 4rpx; top: 18rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--theme-accent, #ff8a3d); }
.detail-tips { border-left: 6rpx solid var(--theme-accent, #ef9f27); border-radius: 0 18rpx 18rpx 0; }
.detail-tip { color: var(--theme-muted, #67554c); font-size: var(--fs-md, 28rpx); line-height: 1.7; }
.detail-tip + .detail-tip { margin-top: 10rpx; padding-top: 10rpx; border-top: 1rpx solid var(--theme-border, #eadfd4); }
.detail-recipes { display: flex; flex-direction: column; gap: 12rpx; }
.detail-recipe {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-height: 0;
  padding: 10rpx;
  border: 1rpx solid var(--theme-border, #eadfd4);
  border-radius: 16rpx;
  background: var(--theme-surface, #fff);
  text-align: left;
  line-height: normal;
}
.detail-recipe .detail-recipe-cover, .detail-recipe-photo { flex: 0 0 88rpx; width: 88rpx; height: 88rpx; border-radius: 12rpx; overflow: hidden; background: var(--theme-soft, #fff0e5); }
.detail-recipe-name { flex: 1; min-width: 0; color: var(--theme-text, #5d4037); font-size: var(--fs-md, 28rpx); font-weight: 600; }
.detail-recipe-time { flex: 0 0 auto; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); }

/* 加载与失败态（设计指南 2.2 / 2.3）：不能出现空白页 */
.detail-state { padding: 120rpx 40rpx 80rpx; text-align: center; }
.detail-state-loading {
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto 24rpx;
  border: 4rpx solid var(--theme-border, #f0e4d8);
  border-top-color: var(--theme-accent-text, #994017);
  border-radius: 50%;
  animation: detail-spin 800ms linear infinite;
}
@keyframes detail-spin { to { transform: rotate(360deg); } }
.detail-state-title { color: var(--theme-text, #4e342c); font-size: var(--fs-lg, 32rpx); font-weight: 700; }
.detail-state-text { margin-top: 12rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); line-height: 1.6; }
.detail-state-primary {
  margin: 36rpx auto 0;
  min-height: 88rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
  background: var(--theme-accent-solid, #c24610);
  color: #fff;
  font-size: var(--fs-md, 28rpx);
  font-weight: 600;
  line-height: 86rpx;
}
.detail-state-retry { display: block; margin: 12rpx auto 0; }
.detail-state-primary.hover { opacity: .75; transform: scale(.98); }

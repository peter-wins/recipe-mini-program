.detail-hero {
  position: relative;
  height: 300rpx;
  margin-top: 20rpx;
  border-radius: var(--card-radius, 28rpx);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.detail-hero .detail-hero-cover { width: 100%; height: 100%; }
.detail-season {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--theme-surface, #fff);
  color: var(--theme-accent-text, #783414);
  font-size: 22rpx;
}
.detail-pending {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-muted, #75665e);
  font-size: 25rpx;
  line-height: 1.6;
}
.detail-card {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.detail-row { display: flex; align-items: flex-start; gap: 14rpx; }
.detail-row + .detail-row { margin-top: 16rpx; }
.detail-tag {
  flex: 0 0 auto;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  color: var(--theme-surface, #fff);
  font-size: 22rpx;
  line-height: 1.5;
}
.detail-tag-therapy { background: #BA7517; }
.detail-tag-audience { background: #639922; }
.detail-row-text { flex: 1; min-width: 0; color: var(--theme-muted, #67554c); font-size: 26rpx; line-height: 1.6; }
.detail-heading { margin-top: 28rpx; margin-bottom: 12rpx; color: var(--theme-text, #5d4037); font-size: 30rpx; font-weight: 750; }
.detail-heading-row { display: flex; align-items: baseline; justify-content: space-between; }
.detail-count { color: var(--theme-muted, #75665e); font-size: 24rpx; font-weight: 400; }
.detail-list-item { position: relative; padding-left: 24rpx; color: var(--theme-muted, #67554c); font-size: 26rpx; line-height: 1.7; }
.detail-list-item + .detail-list-item { margin-top: 8rpx; }
.detail-list-item::before { content: ''; position: absolute; left: 4rpx; top: 18rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--theme-accent, #ff8a3d); }
.detail-tips { border-left: 6rpx solid var(--theme-accent, #ef9f27); border-radius: 0 18rpx 18rpx 0; }
.detail-tip { color: var(--theme-muted, #67554c); font-size: 26rpx; line-height: 1.7; }
.detail-tip + .detail-tip { margin-top: 10rpx; padding-top: 10rpx; border-top: 1rpx solid var(--theme-border, #eadfd4); }
.detail-recipes { display: flex; flex-direction: column; gap: 12rpx; }
.detail-recipe {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-height: 0;
  padding: 10rpx;
  border: 1rpx solid var(--theme-border, #eadfd4);
  border-radius: 16rpx;
  background: var(--theme-surface, #fff);
  text-align: left;
  line-height: normal;
}
.detail-recipe .detail-recipe-cover, .detail-recipe-photo { flex: 0 0 88rpx; width: 88rpx; height: 88rpx; border-radius: 12rpx; overflow: hidden; background: var(--theme-soft, #fff0e5); }
.detail-recipe-name { flex: 1; min-width: 0; color: var(--theme-text, #5d4037); font-size: 28rpx; font-weight: 600; }
.detail-recipe-time { flex: 0 0 auto; color: var(--theme-muted, #75665e); font-size: 23rpx; }

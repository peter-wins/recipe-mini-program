<wxs src="../../icons.wxs" module="icons" />
<view class="theme-page theme-{{themeId}}">
<view class="screen recipe-screen {{recipe ? 'has-nav' : ''}} {{timerStep > 0 ? 'timer-visible' : ''}}">
  <block wx:if="{{recipe}}">
    <view class="recipe-cover {{recipe.image ? 'recipe-cover-photo' : ''}}">
      <recipe-cover wx:if="{{recipe.image}}" class="detail-image" src="{{recipe.image}}" label="{{recipe.name}}成品"/>
      <view class="recipe-cover-caption">
        <view class="headline">{{recipe.name}}</view>
        <view class="recipe-cover-category">{{recipe.libraryCategory}}</view>
      </view>
    </view>

    <view class="recipe-content {{recipe.image ? 'recipe-content-overlap' : ''}}">
      <view class="recipe-facts {{recipe.calories > 0 && !recipe.nutrition ? 'recipe-facts-with-energy' : ''}}">
        <view class="recipe-fact">
          <image class="fact-icon" src="{{icons.path('recipeClock')}}" aria-hidden="true"/>
          <text class="fact-label">{{recipe.durationLabel}}</text>
          <text class="fact-value">{{recipe.minutes}} 分钟</text>
          <text wx:if="{{recipe.waitText}}" class="fact-note">另需等待 {{recipe.waitText}}</text>
          <text wx:elif="{{recipe.durationNote}}" class="fact-note">{{recipe.durationNote}}</text>
        </view>
        <view class="recipe-fact">
          <image class="fact-icon" src="{{icons.path('recipeDifficulty')}}" aria-hidden="true"/>
          <text class="fact-label">难度</text>
          <text class="fact-value">{{recipe.difficulty}}</text>
        </view>
        <view class="recipe-fact">
          <image class="fact-icon" src="{{icons.path('recipeServings')}}" aria-hidden="true"/>
          <view class="fact-label">份量</view>
          <view class="fact-value">{{recipe.servings}} 人份</view>
        </view>
        <view wx:if="{{recipe.calories > 0 && !recipe.nutrition}}" class="recipe-fact">
          <view class="fact-icon fact-energy-icon" aria-hidden="true"></view>
          <text class="fact-label">参考热量</text>
          <text class="fact-value">{{recipe.calories}}<text class="fact-unit"> 千卡</text></text>
        </view>
      </view>

      <view wx:if="{{recipe.nutrition}}" class="recipe-nutrition">
        <view class="row">
          <text class="section">每份参考营养</text>
          <text class="subtle">约 {{recipe.nutrition.servingGrams}} 克</text>
        </view>
        <view class="recipe-nutrition-values">
          <view><text>{{recipe.calories}} 千卡</text><text class="subtle">热量</text></view>
          <view><text>{{recipe.nutrition.protein}} 克</text><text class="subtle">蛋白质</text></view>
          <view><text>{{recipe.nutrition.carbs}} 克</text><text class="subtle">碳水</text></view>
          <view><text>{{recipe.nutrition.fat}} 克</text><text class="subtle">脂肪</text></view>
        </view>
      </view>

      <view id="ingredients" class="list-heading recipe-section">
        <text class="section">食材清单</text>
        <button wx:if="{{inventoryReady && (purchaseItems.length || hasSavedPurchase)}}" class="purchase-cta" bindtap="savePurchaseItems" disabled="{{savingPurchase}}" loading="{{savingPurchase}}" hover-class="hover">{{hasSavedPurchase ? '更新采购项' : '加入采购清单'}}</button>
      </view>
      <view wx:if="{{inventoryReady}}" class="purchase-summary">
        <text class="shopping-note">{{hasSavedPurchase && !purchaseItems.length ? '更新后会移除这道菜的采购项' : (purchaseItems.length ? '已勾选 ' + purchaseItems.length + ' 项待买' : '这次无需补货，点食材可勾选')}}</text>
        <navigator wx:if="{{purchaseItems.length || hasSavedPurchase}}" class="link" url="/pages/shopping/index">看清单</navigator>
      </view>

      <view class="ingredient-list">
        <block wx:for="{{recipe.groups}}" wx:key="key" wx:for-item="group">
          <view wx:if="{{group.items.length}}" class="ingredient-section {{group.key === 'optional' ? 'ingredient-continuation' : ''}}">
            <!-- 可选食材也要有标题：否则与必需食材视觉连成一张表，做菜时会误当必需品准备 -->
            <view class="ingredient-heading {{group.key === 'optional' ? 'ingredient-heading-optional' : ''}}">{{group.key === 'required' ? '食材' : (group.key === 'optional' ? '可选（不影响成菜）' : group.label)}}</view>
            <!-- 辅料（油盐酱醋等常备调料）按名称并列成一段，省略用量：这些用量对备菜帮助很小，
                 却是清单里最长的一段（全库占 39% 的食材行）。用量仍保留在数据里，采购清单不受影响。 -->
            <view wx:if="{{group.key === 'pantry'}}" class="ingredient-pantry">
              <block wx:for="{{group.items}}" wx:key="rowKey"><text wx:if="{{index > 0}}" class="ingredient-pantry-sep">、</text><text class="ingredient-pantry-item">{{item.name}}</text></block>
            </view>
            <block wx:else>
              <block wx:for="{{group.items}}" wx:key="rowKey">
                <button wx:if="{{inventoryReady && group.key === 'required'}}" class="ingredient-line purchase-line" bindtap="togglePurchaseItem" data-id="{{item.id}}" aria-pressed="{{!!purchaseNeeded[item.id]}}" aria-label="{{item.name + (purchaseNeeded[item.id] ? '，待买，点按取消勾选' : '，手边有，点按勾选为待买')}}">
                  <template is="ingredientText" data="{{item, showStatus: true, needed: purchaseNeeded[item.id]}}"/>
                </button>
                <view wx:else class="ingredient-line {{inventoryReady && group.key === 'optional' ? 'ingredient-line-aligned' : ''}}">
                  <template is="ingredientText" data="{{item, optional: group.key === 'optional'}}"/>
                </view>
              </block>
            </block>
          </view>
        </block>
      </view>

      <view id="method" class="list-heading recipe-section">
        <text class="section">做法步骤</text>
        <view class="step-actions">
          <button wx:if="{{recipe.steps[0].image}}" class="link" bindtap="toggleStepText">{{showStepText ? '看步骤图' : '看文字步骤'}}</button>
          <button wx:if="{{cookingIndex >= 0}}" class="link" bindtap="endCooking">看全部</button>
        </view>
      </view>
      <block wx:if="{{cookingIndex >= 0}}">
        <view class="cooking-progress step-progress">第 {{cookingIndex + 1}} / {{recipe.steps.length}} 步</view>
        <template is="recipeStep" data="{{step: recipe.steps[cookingIndex], showStepText}}"/>
      </block>
      <block wx:else>
        <template wx:for="{{recipe.steps}}" wx:key="number" is="recipeStep" data="{{step: item, showStepText, lazy: true}}"/>
        <view wx:if="{{recipe.tips.length}}" class="recipe-notes">
          <view class="section">注意事项</view>
          <view wx:for="{{recipe.tips}}" wx:key="*this" class="recipe-note">
            <view class="recipe-note-dot" aria-hidden="true"></view>
            <text>{{item}}</text>
          </view>
        </view>
      </block>
    </view>
  </block>
  <view wx:elif="{{recipeStatus === 'loading'}}" class="empty" aria-live="polite">正在获取菜谱…</view>
  <view wx:elif="{{recipeStatus === 'error'}}" class="empty recipe-load-error">
    <text>暂时无法获取菜谱，请检查网络。</text>
    <button class="link" bindtap="loadMissingRecipe">重试</button>
  </view>
  <view wx:else class="empty">找不到这道菜谱。</view>
</view>

<view wx:if="{{timerStep > 0}}" class="step-timer-bar">
  <view class="step-timer-copy">
    <text class="step-timer-label">第 {{timerStep}} 步 · {{timerLabel}}</text>
    <text class="step-timer-clock {{timerDone ? 'step-timer-finished' : ''}}">{{timerDone ? '时间到' : remainingText}}</text>
  </view>
  <button wx:if="{{!timerDone}}" class="step-timer-control" bindtap="toggleTimer">{{timerRunning ? '暂停' : '继续'}}</button>
  <button class="step-timer-control step-timer-stop" bindtap="stopTimer">结束</button>
</view>

<view wx:if="{{recipe}}" class="bottom-nav recipe-bar detail-bar">
  <block wx:if="{{cookingIndex < 0}}">
    <button class="detail-save {{saved ? 'detail-saved' : ''}}" bindtap="toggleSaved">
      <image src="{{icons.path(saved ? 'favoriteFilled' : 'favorite')}}" aria-hidden="true"/>
      <text>{{saved ? '已收藏' : '收藏'}}</text>
    </button>
    <button class="detail-schedule" bindtap="scheduleRecipe">
      <image class="meal-calendar-icon" src="{{icons.path('calendar')}}" aria-hidden="true"/>
      <text>安排到日历</text>
    </button>
    <button class="primary" bindtap="startCooking" hover-class="hover">开始烹饪</button>
  </block>
  <block wx:else>
    <button class="detail-prev" disabled="{{cookingIndex === 0}}" bindtap="previousStep">上一步</button>
    <button wx:if="{{recipe.steps[cookingIndex].seconds}}" class="detail-timer" bindtap="startStepTimer" data-step="{{recipe.steps[cookingIndex].number}}" data-seconds="{{recipe.steps[cookingIndex].seconds}}" data-label="{{recipe.steps[cookingIndex].timerText}}" aria-label="为当前步骤计时 {{recipe.steps[cookingIndex].timerText}}">⏱ 计时</button>
    <button class="primary" bindtap="nextStep" hover-class="hover">{{cookingIndex === recipe.steps.length - 1 ? '完成' : '下一步'}}</button>
  </block>
</view>
</view>

<template name="recipeStep">
  <recipe-cover wx:if="{{step.image && !showStepText}}" class="step-photo" src="{{step.image}}" mode="widthFix" label="{{'第' + step.number + '步：' + step.title}}" lazy="{{lazy}}" text-fallback="{{true}}" reserve-square="{{true}}">
    <template is="stepText" data="{{step}}"/>
  </recipe-cover>
  <template wx:else is="stepText" data="{{step}}"/>
</template>
<template name="stepText">
  <view class="step">
    <text class="step-number">{{step.number}}</text>
    <view class="step-content">
      <view wx:if="{{step.title}}" class="step-title">{{step.title}}</view>
      <view>{{step.body}}</view>
    </view>
  </view>
</template>
<template name="ingredientText">
  <view wx:if="{{showStatus}}" class="purchase-circle {{needed ? 'purchase-checked' : ''}}" aria-hidden="true">{{needed ? '✓' : ''}}</view>
  <view class="ingredient-name">
    <text>{{item.name}}</text><text wx:if="{{optional}}" class="ingredient-optional">可选</text>
    <text wx:if="{{showStatus}}" class="ingredient-status {{needed ? 'ingredient-missing' : ''}}">{{needed ? '待买' : '手边有'}}</text>
  </view>
  <view class="ingredient-quantity">
    <text>{{item.quantity}}</text>
  </view>
</template>


.recipe-screen { padding-top: 0; padding-right: 0; padding-left: 0; }
.recipe-cover {
  position: relative;
  display: flex;
  align-items: flex-end;
  min-height: 184rpx;
  padding: 30rpx 32rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--theme-placeholder, #fae4cf);
}
.recipe-cover-photo { min-height: 466rpx; padding-bottom: 58rpx; color: #fff; }
.recipe-cover-photo .detail-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.recipe-cover-photo::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent 38%, rgba(36, 20, 10, .84));
  content: '';
}
.recipe-cover-caption { position: relative; z-index: 1; }
.recipe-cover-category { margin-top: 8rpx; font-size: var(--fs-md, 28rpx); }
.recipe-content { position: relative; padding: 24rpx 28rpx 0; background: var(--theme-page-bg, #FFF8F0); }
.recipe-content-overlap { z-index: 2; margin-top: -26rpx; border-radius: 26rpx 26rpx 0 0; }
.recipe-facts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 18rpx 0;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 20rpx;
  background: #fff;
}
.recipe-facts-with-energy { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.recipe-fact { display: block; padding: 4rpx 8rpx; text-align: center; }
.recipe-fact + .recipe-fact { border-left: 1rpx solid var(--theme-border, #f0e4d8); }
.fact-icon { display: block; width: 36rpx; height: 36rpx; margin: 0 auto 8rpx; }
.fact-label, .fact-value { display: block; }
.fact-label { color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); }
.fact-value { margin-top: 6rpx; font-size: var(--fs-lg, 32rpx); font-weight: 700; }
.fact-note { display: block; margin-top: 4rpx; color: var(--theme-accent-text, #994017); font-size: var(--fs-sm, 24rpx); line-height: 1.3; }
.fact-unit { font-size: var(--fs-xs, 22rpx); font-weight: 500; }
.fact-energy-icon { position: relative; }
.fact-energy-icon::before {
  position: absolute;
  inset: 3rpx 8rpx;
  background: var(--theme-accent-text, #a35a36);
  clip-path: polygon(56% 0, 0 57%, 40% 57%, 31% 100%, 100% 39%, 57% 39%, 68% 0);
  content: '';
}
.recipe-nutrition {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.recipe-nutrition-values {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 14rpx;
}
.recipe-nutrition-values view { padding: 4rpx; text-align: center; font-size: var(--fs-md, 28rpx); font-weight: 700; }
.recipe-nutrition-values view + view { border-left: 1rpx solid var(--theme-border, #f0e4d8); }
.recipe-nutrition-values text { display: block; }
.recipe-nutrition-values .subtle { font-size: var(--fs-sm, 24rpx); font-weight: 400; }
.recipe-notes {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 20rpx;
  background: #fff;
}
.recipe-notes .section { margin-bottom: 14rpx; font-size: var(--fs-lg, 32rpx); }
.recipe-note { display: flex; align-items: flex-start; gap: 14rpx; font-size: var(--fs-md, 28rpx); line-height: 1.65; }
.recipe-note + .recipe-note { margin-top: 10rpx; }
.recipe-note-dot { flex: 0 0 8rpx; height: 8rpx; margin-top: 18rpx; border-radius: 50%; background: var(--theme-accent-text, #a35a36); }
.fact-editable { color: var(--theme-accent-text, #994017); }
.recipe-section { margin-top: 26rpx; min-height: 62rpx; padding-bottom: 10rpx; }
.recipe-section .link { line-height: 62rpx; }
/* 「加入采购清单」是本页唯一转化动作，用描边胶囊与普通「查看更多」区分开，但仍留在标题行内不破坏布局 */
/* 不自带 .link 类：带底色的按钮若同时是 .link，会被 app.wxss 的
   button.link[disabled]{background:transparent} 置空底色。这里独立定义，不依赖样式顺序。 */
.purchase-cta {
  flex-shrink: 0;
  padding: 0 20rpx;
  line-height: 58rpx;
  min-height: 58rpx;
  border: 1rpx solid var(--theme-selected-border, #d9b59a);
  border-radius: var(--r-full, 999rpx);
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-accent-text, #994017);
  font-size: var(--fs-sm, 24rpx);
  font-weight: 600;
  transition: opacity .15s, transform .15s;
}
.purchase-cta.hover { opacity: .6; }
button.purchase-cta[disabled] { background: var(--theme-soft, #fff0e5); color: var(--state-disabled, #8f8177); }
.purchase-summary { display: flex; align-items: center; flex-wrap: wrap; gap: 4rpx; margin-bottom: 12rpx; }
.shopping-note { color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); }
.purchase-summary .link { padding: 0 8rpx; line-height: 62rpx; font-size: var(--fs-sm, 24rpx); }
.ingredient-list { overflow: hidden; border: 1rpx solid var(--theme-border, #f0e4d8); border-radius: 20rpx; background: #fff; }
.ingredient-section { padding: 16rpx 20rpx 4rpx; }
.ingredient-section + .ingredient-section { border-top: 1rpx solid var(--theme-border, #f0e4d8); }
.ingredient-section.ingredient-continuation { padding-top: 0; border-top: 0; }
.ingredient-heading { padding: 0 2rpx 6rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); font-weight: 600; }
/* 可选食材标题：与必需食材之间留一点呼吸，但比独立分组紧凑。必须写在 .ingredient-heading 之后。 */
.ingredient-heading.ingredient-heading-optional { padding-top: 14rpx; }
.ingredient-line {
  display: flex;
  align-items: center;
  gap: 13rpx;
  width: 100%;
  min-height: 72rpx;
  padding: 12rpx 2rpx;
  box-sizing: border-box;
  background: #fff;
  font-size: var(--fs-md, 28rpx);
  line-height: 1.4;
  text-align: left;
}
.ingredient-line + .ingredient-line { border-top: 1rpx solid var(--theme-border, #f5ede5); }
.ingredient-continuation .ingredient-line:first-child { border-top: 1rpx solid var(--theme-border, #f5ede5); }
.ingredient-line-aligned { padding-left: 55rpx; }
.purchase-line { min-height: 88rpx; border-radius: 0; }
.purchase-circle {
  flex: 0 0 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 3rpx solid #cbbdb1;
  border-radius: 50%;
  color: var(--theme-text, #43251b);
  font-size: var(--fs-sm, 24rpx);
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}
.purchase-checked { border-color: var(--theme-accent, #FF8A3D); background: var(--theme-accent, #FF8A3D); }
.ingredient-name { flex: 1; min-width: 0; }
.ingredient-optional { margin-left: 12rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-xs, 22rpx); }
.ingredient-status { display: block; color: var(--theme-muted, #75665e); font-size: var(--fs-xs, 22rpx); }
.ingredient-missing { color: var(--stock-missing, #c04040); }
.ingredient-quantity { max-width: 55%; flex-shrink: 0; color: var(--theme-muted, #75665e); text-align: right; overflow-wrap: anywhere; }
.ingredient-note { display: block; font-size: var(--fs-xs, 22rpx); }
.recipe-content .step { margin-top: 0; margin-bottom: 14rpx; }
.step-actions { display: flex; align-items: center; gap: 12rpx; }
.step-actions .subtle { white-space: nowrap; }
.step-progress { margin-bottom: 12rpx; }
.step-photo {
  display: block;
  width: 100%;
  margin-bottom: 16rpx;
  overflow: hidden;
  border-radius: 16rpx;
}
.detail-bar {
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 0;
  background: #fff;
  box-shadow: none;
}
.detail-bar .primary { min-height: 86rpx; line-height: 86rpx; }
.detail-save, .detail-prev { flex: 0 0 138rpx; padding: 0; background: transparent; }
.detail-save, .detail-schedule { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; min-height: 86rpx; line-height: 1.3; font-size: var(--fs-sm, 24rpx); }
.detail-save { flex-basis: 88rpx; }
.detail-save image { width: 35rpx; height: 35rpx; }
.detail-schedule { flex: 0 0 144rpx; padding: 0; background: transparent; white-space: nowrap; }
.detail-schedule .meal-calendar-icon { width: 32rpx; height: 32rpx; margin: 2rpx 0 3rpx; }
.detail-saved { color: var(--theme-accent-text, #994017); font-weight: 700; }
.detail-saved image { filter: var(--theme-accent-icon); }
.detail-prev { color: var(--theme-accent-text, #994017); line-height: 86rpx; }
button.detail-prev[disabled] { background: transparent; color: var(--state-disabled, #8f8177); }
.detail-bar .detail-prev { flex: 0 0 118rpx; }
.detail-timer {
  flex: 0 0 130rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--theme-accent, #FF8A3D);
  border-radius: var(--r-full, 999rpx);
  background: #fff;
  color: var(--theme-accent-text, #994017);
  font-size: var(--fs-md, 28rpx);
  font-weight: 600;
  line-height: 62rpx;
}

.recipe-screen.timer-visible { padding-bottom: calc(300rpx + env(safe-area-inset-bottom)); }
.step-timer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 11;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  border-top: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 24rpx 24rpx 0 0;
  background: var(--theme-page-bg, #fff8f0);
  box-shadow: 0 -8rpx 24rpx rgba(150, 80, 30, 0.1);
}
.step-timer-copy { flex: 1; min-width: 0; }
.step-timer-label { display: block; overflow: hidden; color: var(--theme-muted, #75665e); font-size: var(--fs-xs, 22rpx); text-overflow: ellipsis; white-space: nowrap; }
.step-timer-clock { display: block; margin-top: 2rpx; color: var(--theme-text, #4e342c); font-size: var(--fs-xl, 36rpx); font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.15; }
.step-timer-finished { color: var(--theme-accent-text, #994017); }
.step-timer-control {
  flex: 0 0 104rpx;
  min-height: 64rpx;
  padding: 0;
  border-radius: var(--r-full, 999rpx);
  background: var(--theme-accent-solid, #c24610);
  color: #fff;
  font-size: var(--fs-sm, 24rpx);
  line-height: 64rpx;
}
.step-timer-stop { background: #f1e7de; color: var(--theme-muted, #75665e); }
.recipe-load-error .link { display: block; margin: 10rpx auto 0; }

/* 食材 / 步骤 跳转条（P0-2）：避免只想看做法的人划过整份食材清单 */
.recipe-jump {
  display: flex;
  gap: 12rpx;
  margin: 18rpx 0 4rpx;
}
.recipe-jump-item {
  flex: 1;
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--r-full, 999rpx);
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-accent-text, #994017);
  font-size: var(--fs-md, 28rpx);
  font-weight: 600;
  line-height: 74rpx;
  text-align: center;
}

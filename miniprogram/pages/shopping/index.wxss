.shopping-head { padding: 12rpx 0 24rpx; }
.shopping-head-row { gap: 16rpx; align-items: center; }
.shopping-head-copy { flex: 1; min-width: 0; }
.shopping-title { color: var(--theme-text, #4e342c); font-size: 50rpx; font-weight: 750; line-height: 1.2; }
.shopping-subtitle { margin-top: 7rpx; color: var(--theme-muted, #75665e); font-size: 23rpx; }
.shopping-add {
  display: flex;
  flex-shrink: 0;
  align-self: flex-start;
  align-items: center;
  gap: 8rpx;
  min-height: 0;
  padding: 0 18rpx;
  border: 1rpx solid var(--theme-selected-border, #d9b59a);
  border-radius: 20rpx;
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-accent-text, #994017);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 62rpx;
  white-space: nowrap;
}
.shopping-add image { width: 27rpx; height: 27rpx; filter: var(--theme-accent-icon); }
.shopping-screen-with-bar { padding-bottom: calc(204rpx + env(safe-area-inset-bottom)); }
.shopping-list-head { margin-top: 22rpx; }
.shopping-list-head .section { font-size: 28rpx; }
.shopping-multi { padding-right: 0; }
.shopping-list { border: 1rpx solid var(--theme-border, #f0e4d8); border-radius: var(--card-radius, 28rpx); background: var(--theme-surface, #fff); overflow: hidden; }
.shopping-row { padding: 12rpx 20rpx; }
.shopping-row + .shopping-row { border-top: 1rpx solid var(--theme-border, #f0e4d8); }
.shopping-row-main { display: flex; align-items: center; gap: 10rpx; min-height: 64rpx; }
.shopping-row-selected { background: var(--theme-soft, #fff4ec); }
/* 用量跟在食材名后面，同一行排布；过长时换行不溢出 */
.shopping-item-copy { flex: 1; min-width: 0; display: flex; align-items: center; flex-wrap: wrap; column-gap: 8rpx; }
.shopping-select-row { display: flex; width: 100%; min-height: 76rpx; margin: 0; padding: 0; align-items: center; gap: 14rpx; background: transparent; line-height: 1.4; text-align: left; }
.shopping-select-row .shopping-item-name { flex: 1; }
.shopping-selected-quantity { max-width: 36%; text-align: right; overflow-wrap: anywhere; }
.shopping-check { display: flex; flex: 0 0 34rpx; height: 34rpx; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid var(--theme-selected-border, #d9b59a); border-radius: 50%; font-size: 23rpx; }
.shopping-row-selected .shopping-check { border-color: var(--theme-accent, #c87137); background: var(--theme-accent, #c87137); color: #fff; }
/* 行内小按钮局部降到 64rpx，配合单行名称+用量，避免撑高整行；不改全局 88rpx 最小点击区 */
.shopping-bought { flex-shrink: 0; min-width: 96rpx; min-height: 64rpx; padding: 0 7rpx; font-size: 24rpx; line-height: 64rpx; border-radius: 14rpx; background: var(--theme-selected, #fbecdc); color: var(--theme-accent-text, #994017); font-weight: 650; }
/* 移除按钮复用冰箱页「已有食材」的圆形描边减号图标 */
.shopping-remove {
  display: flex;
  flex: 0 0 64rpx;
  min-width: 64rpx;
  min-height: 64rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  background: transparent;
}
.shopping-remove-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  color: #75665e;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1;
}
.shopping-export { margin-top: 24rpx; text-align: center; }
.shopping-export .primary { width: 100%; min-height: 88rpx; line-height: 88rpx; }
.shopping-copy { display: inline-flex; align-items: center; justify-content: center; gap: 10rpx; margin-top: 12rpx; }
.shopping-copy image { width: 32rpx; height: 32rpx; opacity: .8; }
.shopping-export-hint { margin-top: 8rpx; font-size: 23rpx; }
.shopping-poster-canvas { position: fixed; left: -9999rpx; top: 0; width: 750px; height: 1px; pointer-events: none; }
.shopping-entry { display: block; }
.shopping-entry-fields { display: flex; align-items: flex-start; gap: 16rpx; }
.shopping-entry-field { flex: 2; min-width: 0; font-size: 26rpx; color: var(--theme-muted, #75665e); }
.shopping-entry-field:last-child { flex: 1; }
.shopping-entry-input {
  box-sizing: border-box;
  height: 72rpx;
  margin-top: 8rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 16rpx;
  background: var(--theme-page-bg, #fff8f0);
  color: var(--theme-text, #5d4037);
  font-size: 26rpx;
}
.shopping-entry-actions { display: flex; justify-content: flex-end; align-items: center; gap: 12rpx; margin-top: 14rpx; }
/* 「加入清单」与文字「取消」视觉齐平：局部降到 76rpx，不改全局最小点击区规范 */
.shopping-entry-actions .primary { min-height: 76rpx; line-height: 76rpx; }
.shopping-item-name { display: inline; min-width: 0; font-size: 29rpx; font-weight: 650; line-height: 1.35; overflow-wrap: anywhere; }
.shopping-quantity {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  max-width: 100%;
  min-height: 0;
  padding: 0;
  color: var(--theme-muted, #75665e);
  font-size: 24rpx;
  line-height: 1.35;
  white-space: normal;
  text-align: left;
}
.shopping-quantity text:first-child { min-width: 0; overflow-wrap: anywhere; }
.shopping-chevron { flex-shrink: 0; }
.shopping-details {
  margin-top: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  background: var(--theme-soft, #fff3e8);
}
.shopping-detail { align-items: flex-start; gap: 16rpx; padding: 8rpx 0; }
.shopping-detail .quantity { max-width: 52%; overflow-wrap: anywhere; }
.shopping-dock { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 10rpx 30rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--theme-border, #f0e4d8); background: var(--theme-surface, #fff); }
.shopping-batch { gap: 12rpx; }
.shopping-batch .primary { min-width: 238rpx; }
.shopping-undo { gap: 12rpx; min-height: 68rpx; font-size: 26rpx; }
.shopping-undo-action { padding-right: 0; }

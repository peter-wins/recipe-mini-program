<view class="theme-page theme-{{themeId}}">
  <view class="screen">
    <view class="page-head">
      <view class="headline">采购清单</view>
      <view wx:if="{{items.length}}" class="subtle">待买 {{items.length}} 种食材</view>
    </view>
    <view wx:if="{{!items.length}}" class="empty">从菜谱详情加入缺少的食材。</view>
    <view wx:for="{{items}}" wx:key="key" class="purchase-row">
      <view class="row">
        <text class="recipe-name shopping-item-name">{{item.name}}</text>
        <button class="link shopping-quantity" bindtap="toggleDetails" data-key="{{item.key}}" aria-expanded="{{item.expanded}}" aria-label="{{item.name + '，' + item.quantity + '，用量明细'}}">
          <text>{{item.quantity}}</text>
          <text class="shopping-chevron" aria-hidden="true">{{item.expanded ? '⌃' : '⌄'}}</text>
        </button>
      </view>
      <view wx:if="{{item.expanded}}" class="shopping-details">
        <view wx:for="{{item.details}}" wx:for-item="detail" wx:key="key" class="row subtle shopping-detail">
          <text>{{detail.title}}</text><text class="quantity">{{detail.quantity}}</text>
        </view>
      </view>
      <view class="actions">
        <button class="primary" bindtap="markBought" disabled="{{!!updatingKey}}" data-key="{{item.key}}" aria-label="已买{{item.name}}，加入冰箱">已买入库</button>
        <button class="link" bindtap="removeItem" disabled="{{!!updatingKey}}" data-key="{{item.key}}" aria-label="从清单移除{{item.name}}">移除</button>
      </view>
    </view>
  </view>
</view>

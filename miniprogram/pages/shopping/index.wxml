<wxs src="../../icons.wxs" module="icons" />
<view class="theme-page theme-{{themeId}}">
  <view class="screen shopping-screen {{selecting || undoCount ? 'shopping-screen-with-bar' : ''}}">
    <view class="page-head shopping-head">
      <view class="row shopping-head-row">
        <view class="shopping-head-copy">
          <view class="shopping-title">{{items.length ? '还差 ' + items.length + ' 样' : '采购清单'}}</view>
          <view class="shopping-subtitle">{{usageNote}}</view>
        </view>
      </view>
      <view class="shopping-add-actions">
        <image class="shopping-hero-art" src="{{heroSrc}}" mode="aspectFit" aria-hidden="true"/>
        <button class="shopping-add" bindtap="{{manualOpen ? 'closeManualEntry' : 'openManualEntry'}}" aria-expanded="{{manualOpen}}" hover-class="shopping-action-pressed">
          <image src="{{icons.path('plus')}}" aria-hidden="true"/>手动添加
        </button>
        <navigator class="shopping-add" url="/pages/home/index?view=library" hover-class="shopping-action-pressed">
          <image src="{{icons.path('cookbook')}}" aria-hidden="true"/>从菜谱添加
        </navigator>
      </view>
    </view>
    <form wx:if="{{manualOpen}}" class="purchase-row shopping-entry" bindsubmit="addManualItem">
      <view class="shopping-entry-fields">
        <view class="shopping-entry-field">
          <text>名称</text>
          <input name="name" class="shopping-entry-input" placeholder="例如牛奶、厨房纸" aria-label="名称" maxlength="{{manualNameLimit}}" focus="{{!focusQuantity}}" confirm-type="next" confirm-hold="{{true}}" bindconfirm="focusManualQuantity"/>
        </view>
        <view class="shopping-entry-field">
          <text>用量（选填）</text>
          <input name="quantity" class="shopping-entry-input" placeholder="例如 2 盒" aria-label="用量，选填" maxlength="{{manualQuantityLimit}}" focus="{{focusQuantity}}"/>
        </view>
      </view>
      <view class="shopping-entry-actions">
        <button class="link" bindtap="closeManualEntry">取消</button>
        <button class="primary" form-type="submit" hover-class="hover">加入清单</button>
      </view>
    </form>
    <view wx:if="{{!items.length && !manualOpen}}" class="empty">
      <view>目前没有待买的东西。</view>
      <navigator class="secondary empty-action" url="/pages/home/index?view=library" open-type="redirect" hover-class="hover">去菜谱挑食材</navigator>
    </view>
    <block wx:if="{{items.length}}">
      <view class="shopping-list">
        <view class="row shopping-list-head">
          <view class="shopping-list-title">
            <image src="{{icons.path('cart')}}" aria-hidden="true"/>
            <text class="section">{{selecting ? '已选 ' + selectedCount + ' 项' : '待买 ' + items.length + ' 项'}}</text>
          </view>
          <button class="link shopping-multi" bindtap="toggleBatchMode" hover-class="hover" aria-pressed="{{selecting}}">{{selecting ? '取消多选' : '多选'}}</button>
        </view>
        <view wx:for="{{items}}" wx:key="key" class="shopping-row {{item.selected ? 'shopping-row-selected' : ''}}">
          <view class="shopping-row-main">
            <button class="shopping-select" bindtap="toggleSelection" disabled="{{updating}}" data-key="{{item.key}}" aria-pressed="{{item.selected}}" aria-label="{{(item.selected ? '取消选择' : '选择') + item.name}}">
              <text class="shopping-check" aria-hidden="true">{{item.selected ? '✓' : ''}}</text>
            </button>
            <button class="shopping-item-toggle" bindtap="toggleDetails" hover-class="shopping-action-pressed" data-key="{{item.key}}" aria-expanded="{{item.expanded}}" aria-label="{{item.name + '，' + item.quantity + '，' + (item.expanded ? '收起明细' : '查看明细')}}">
              <recipe-cover wx:if="{{item.coverUrl}}" class="shopping-item-cover" src="{{item.coverUrl}}" mode="aspectFill" lazy="{{true}}" textFallback="{{true}}"/>
              <view class="shopping-item-copy">
                <text class="shopping-item-name">{{item.name}}</text>
                <text class="shopping-quantity">{{item.quantity}}</text>
              </view>
              <view class="shopping-chevron {{item.expanded ? 'shopping-chevron-open' : ''}}" aria-hidden="true"></view>
            </button>
          </view>
          <view wx:if="{{item.expanded}}" class="shopping-details">
            <view wx:for="{{item.details}}" wx:for-item="detail" wx:key="key" class="row subtle shopping-detail">
              <text>{{detail.title}}</text><text class="quantity">{{detail.quantity}}</text>
            </view>
            <button class="text-btn shopping-remove" bindtap="removeItem" disabled="{{updating}}" data-key="{{item.key}}" aria-label="{{'从清单移除' + item.name}}">移除</button>
          </view>
        </view>
      </view>
      <view wx:if="{{!selecting}}" class="shopping-export">
        <button class="secondary shopping-export-action" bindtap="copyTextList" disabled="{{updating}}" hover-class="hover">
          <image src="{{icons.path('copy')}}" aria-hidden="true"/>复制清单
        </button>
        <button class="secondary shopping-export-action" bindtap="exportPoster" disabled="{{updating}}" hover-class="hover">
          <image src="{{icons.path('image')}}" aria-hidden="true"/>保存图片
        </button>
      </view>
    </block>
  </view>
  <canvas type="2d" id="shopping-poster" class="shopping-poster-canvas" style="width:{{posterWidth}}px;height:{{posterHeight}}px;"></canvas>
  <view wx:if="{{selecting || undoCount}}" class="shopping-dock">
    <view class="screen shopping-dock-inner">
      <view wx:if="{{undoCount}}" class="shopping-undo row" aria-live="polite">
        <text>已买 {{undoCount}} 项</text>
        <button class="link shopping-undo-action" bindtap="undoBought" hover-class="hover">撤销</button>
      </view>
      <view wx:if="{{selecting}}" class="shopping-batch row">
        <button class="link shopping-select-all" bindtap="toggleAll" hover-class="hover">{{selectedCount === items.length ? '取消全选' : '全选'}}</button>
        <button class="primary" bindtap="markSelectedBought" hover-class="hover" disabled="{{!selectedCount || updating}}">{{selectedCount ? '标记 ' + selectedCount + ' 项已买' : '标记已买'}}</button>
      </view>
    </view>
  </view>
</view>

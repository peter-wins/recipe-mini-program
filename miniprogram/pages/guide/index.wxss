@import "../../styles/recipe-search.wxss";

.guide-fill { display: flex; flex-direction: column; height: 100vh; }
.guide-fill .screen.guide-screen {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  width: 100%;
  max-width: none;
  margin-left: 0;
  margin-right: 0;
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.guide-intro { margin-top: 8rpx; position: relative; }
.guide-intro .section { font-size: var(--fs-3xl, 52rpx); }
.guide-intro .subtle { margin-top: 6rpx; }

/* 同步状态：叠在标题行右侧空白，绝对定位不占文档流。
   本页是 height:100vh 固定高度布局，任何占位元素都会挤掉列表可视高度；
   而 offline 在「从未成功同步过」的设备上会长期停留，不能按短暂提示处理。 */
.guide-sync {
  position: absolute;
  top: 0;
  right: 0;
  max-width: 286rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
}
.guide-sync-text { font-size: var(--fs-xs, 22rpx); line-height: 1.4; }
/* loading 短暂，给足动效提示 */
.guide-sync-loading .guide-sync-text { color: var(--theme-accent-text, #994017); }
.guide-sync-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--theme-accent-text, #994017);
  animation: sync-pulse 1.1s ease-in-out infinite;
}
/* offline 长期存在，弱化到一行灰色小字，不抢标题和列表的注意力 */
.guide-sync-offline .guide-sync-text { color: var(--theme-muted, #75665e); }
.recipe-search.guide-search { margin-top: 18rpx; margin-bottom: 18rpx; }
.guide-body { flex: 1; display: flex; gap: 16rpx; min-height: 0; }
.guide-groups {
  flex: 0 0 160rpx;
  width: 160rpx;
  height: 100%;
  border-radius: var(--r-md, 18rpx);
  background: var(--theme-neutral, #f1e6d9);
  padding: 8rpx;
}
.guide-group {
  display: block;
  width: 100%;
  padding: 0 12rpx;
  border-radius: var(--r-sm, 12rpx);
  background: transparent;
  color: var(--theme-muted, #67554c);
  font-size: var(--fs-sm, 24rpx);
  line-height: 72rpx;
  text-align: center;
  white-space: nowrap;
}
.guide-group-active { background: var(--theme-surface, #fff); color: var(--theme-accent-text, #783414); font-weight: 700; }
.guide-list-scroll { flex: 1; min-width: 0; height: 100%; }
.guide-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-4, 16rpx); }
.guide-card {
  display: block;
  padding: 0;
  overflow: hidden;
  border: 1rpx solid var(--theme-border, #eadfd4);
  border-radius: var(--r-md, 18rpx);
  background: var(--theme-surface, #fff);
  min-height: 0;
  line-height: normal;
}
.guide-card-image { height: 132rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.guide-card-image .guide-card-cover { width: 100%; height: 100%; }
.guide-card-copy { padding: 12rpx 14rpx 16rpx; text-align: left; }
.guide-card-name { color: var(--theme-text, #5d4037); font-size: var(--fs-md, 28rpx); font-weight: 600; }
.guide-card-count { margin-top: 4rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-xs, 22rpx); }
.guide-empty { padding: 40rpx 0; }

/* 搜索历史（设计指南 3.1） */
.search-history { padding: 12rpx 4rpx 8rpx; }
.search-history-head { display: flex; align-items: center; justify-content: space-between; }
.search-history-label { color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); }
.search-history-clear { min-height: 44rpx; line-height: 44rpx; font-size: var(--fs-sm, 24rpx); }
.search-history-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.search-history-word {
  max-width: 100%;
  min-height: 64rpx;
  padding: 0 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--r-full, 999rpx);
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-accent-text, #994017);
  font-size: var(--fs-sm, 24rpx);
  line-height: 62rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

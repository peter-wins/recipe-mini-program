<wxs src="../../icons.wxs" module="icons" />
<view class="theme-page theme-{{themeId}} guide-fill">
  <view class="screen guide-screen">
    <view class="guide-intro">
      <view class="section">认识食材，做对菜</view>
      <view class="subtle">挑得新鲜、存得妥当、吃得明白</view>
      <!-- 同步状态叠在标题行右侧的空白处，不占文档流，避免挤掉列表高度。 -->
      <view wx:if="{{syncState === 'loading'}}" class="guide-sync guide-sync-loading" aria-live="polite">
        <view class="guide-sync-dot" aria-hidden="true"></view>
        <text class="guide-sync-text">正在更新</text>
      </view>
      <view wx:elif="{{syncState === 'offline'}}" class="guide-sync guide-sync-offline" aria-live="polite">
        <text class="guide-sync-text">云端未连接</text>
      </view>
    </view>

    <view class="recipe-search guide-search">
      <view class="search-mark" aria-hidden="true"></view>
      <input class="recipe-search-input" value="{{search}}" bindinput="searchIngredients" bindfocus="focusSearch" bindblur="blurSearch" bindconfirm="confirmSearch" confirm-type="search" placeholder="搜索食材，如 菠菜"/>
      <button wx:if="{{search}}" class="link" bindtap="clearSearch">清除</button>
    </view>

    <view wx:if="{{focused && searchHistory.length}}" class="search-history">
      <view class="search-history-head">
        <text class="search-history-label">最近搜过</text>
        <button class="link search-history-clear" bindtap="clearSearchHistory">清空</button>
      </view>
      <view class="search-history-list">
        <button wx:for="{{searchHistory}}" wx:key="*this" class="search-history-word" data-word="{{item}}" bindtap="useSearchHistory">{{item}}</button>
      </view>
    </view>

    <view class="guide-body">
      <scroll-view wx:if="{{!searching}}" class="guide-groups" scroll-y enhanced show-scrollbar="{{false}}">
        <button wx:for="{{groups}}" wx:key="*this" class="guide-group {{groupIndex === index ? 'guide-group-active' : ''}}" data-index="{{index}}" bindtap="selectGroup" aria-pressed="{{groupIndex === index}}">{{item}}</button>
      </scroll-view>
      <scroll-view class="guide-list-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{!visibleIngredients.length}}" class="empty guide-empty">{{searching ? '没找到这个食材' : '这个分类还在整理中'}}</view>
        <view wx:else class="guide-list">
          <button wx:for="{{visibleIngredients}}" wx:key="id" class="guide-card" data-id="{{item.id}}" bindtap="openDetail" hover-class="card-pressed">
            <view class="guide-card-image" style="background:{{item.tint}}">
              <recipe-cover class="guide-card-cover" src="{{item.image}}" mode="aspectFit" lazy="{{true}}"/>
            </view>
            <view class="guide-card-copy">
              <view class="guide-card-name">{{item.name}}</view>
              <view class="guide-card-count">{{item.recipeCount ? item.recipeCount + ' 道做法' : '整理中'}}</view>
            </view>
          </button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

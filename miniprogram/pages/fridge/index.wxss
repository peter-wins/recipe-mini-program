@import "../../styles/recipe-search.wxss";
@import "../../styles/recipe-card.wxss";

.fridge-fill { display: flex; flex-direction: column; height: 100vh; }
.fridge-fill .screen { flex: 1; display: flex; flex-direction: column; min-height: 0; }

/* 顶部轮播灵感卡 */
.fridge-banner { flex: 0 0 auto; height: 232rpx; border-radius: var(--card-radius, 28rpx); overflow: hidden; }
.fridge-banner-slide { position: relative; height: 100%; border-radius: var(--card-radius, 28rpx); overflow: hidden; background: #f6d9a8; }
.fridge-banner-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.fridge-banner-copy { position: absolute; left: 28rpx; top: 32rpx; max-width: 62%; }
.fridge-banner-eyebrow { color: #803c1e; font-size: 22rpx; }
.fridge-banner-title { margin-top: 4rpx; color: #5d2f14; font-size: 32rpx; font-weight: 750; line-height: 1.3; }
.fridge-banner-sub { margin-top: 4rpx; color: #803c1e; font-size: 22rpx; }

.fridge-search-row { display: flex; align-items: center; gap: 16rpx; }
.fridge-search-row .recipe-search { flex: 1; min-width: 0; }
.fridge-cart {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 86rpx;
  height: 86rpx;
  border-radius: 22rpx;
  background: var(--theme-soft, #fff2e8);
}
.fridge-cart image { width: 40rpx; height: 40rpx; }
.fridge-edit { flex: 1; display: flex; flex-direction: column; min-height: 0; margin-top: 24rpx; }
.recipe-search.fridge-search { margin-bottom: 0; border-radius: 22rpx; }
.fridge-picker-head { margin-top: 24rpx; margin-bottom: 12rpx; }
.fridge-picker-body { flex: 1; display: flex; gap: 18rpx; min-height: 0; }
.fridge-groups {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 100%;
  border-radius: 18rpx;
  background: var(--theme-neutral, #f7f3ee);
}
.fridge-group {
  display: block;
  width: 100%;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: transparent;
  color: var(--theme-muted, #67554c);
  font-size: 25rpx;
  line-height: 76rpx;
  text-align: left;
}
.fridge-group-active { background: var(--theme-surface, #fff); color: var(--theme-accent-text, #783414); font-weight: 700; }
.fridge-options-scroll { flex: 1; min-width: 0; height: 100%; }
.fridge-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.fridge-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  min-width: 0;
  min-height: 76rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 14rpx;
  background: var(--theme-soft, #fffaf5);
  color: var(--theme-text, #5d4037);
  font-size: 27rpx;
  line-height: 1.35;
  text-align: left;
}
.fridge-option-name { min-width: 0; overflow-wrap: anywhere; }
.fridge-option-mark { flex-shrink: 0; color: var(--theme-accent-text, #994017); font-weight: 700; }
.fridge-option-checked { background: var(--theme-selected, #ffe8d5); border-color: var(--theme-selected-border, #e9a879); color: var(--theme-accent-text, #783414); }
.fridge-empty { padding: 30rpx 0; }
.fridge-more { display: block; margin: 14rpx auto 0; }
/* 手边有的分组：移除提示 + 清空（规范第5条危险操作用语义色） */
.fridge-picked-bar { margin-bottom: 12rpx; }
.fridge-picked-hint { color: var(--theme-muted, #75665e); font-size: 24rpx; }
.text-btn.fridge-clear {
  padding: 0 8rpx;
  min-height: 0;
  background: transparent;
  border: 0;
  color: var(--state-danger, #c04040);
  font-size: 24rpx;
  line-height: 1.5;
}
.fridge-picked-foot { margin-top: 16rpx; color: var(--theme-muted, #75665e); font-size: 23rpx; text-align: center; }

@import "../../styles/recipe-search.wxss";
@import "../../styles/recipe-card.wxss";

.fridge-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: var(--theme-soft, #fff2e8);
}
.fridge-icon image { width: 36rpx; height: 36rpx; }
.fridge-card {
  padding: 24rpx;
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.fridge-picked {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}
.fridge-picked-chip, .fridge-expand, .fridge-clear {
  max-width: 100%;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #fff2e8);
  color: var(--theme-accent-text, #803c1e);
  font-size: 24rpx;
  line-height: 58rpx;
  overflow-wrap: anywhere;
}
.fridge-picked-chip text { margin-left: 4rpx; }
.fridge-expand { background: var(--theme-neutral, #f7f3ee); color: var(--theme-muted, #67554c); }
.fridge-clear { background: transparent; color: var(--theme-muted, #75665e); }
.fridge-edit { margin-top: 20rpx; }
.recipe-search.fridge-search { margin-bottom: 16rpx; border-radius: 26rpx; }
.fridge-picker-head { margin-bottom: 12rpx; }
.fridge-picker-body { display: flex; gap: 18rpx; height: 640rpx; }
.fridge-groups {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 100%;
  border-radius: 18rpx;
  background: var(--theme-neutral, #f7f3ee);
}
.fridge-group {
  display: block;
  width: 100%;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: transparent;
  color: var(--theme-muted, #67554c);
  font-size: 25rpx;
  line-height: 76rpx;
  text-align: left;
}
.fridge-group-active { background: var(--theme-surface, #fff); color: var(--theme-accent-text, #783414); font-weight: 700; }
.fridge-options-scroll { flex: 1; min-width: 0; height: 100%; }
.fridge-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.fridge-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  min-width: 0;
  min-height: 76rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 14rpx;
  background: var(--theme-soft, #fffaf5);
  color: var(--theme-text, #5d4037);
  font-size: 27rpx;
  line-height: 1.35;
  text-align: left;
}
.fridge-option-name { min-width: 0; overflow-wrap: anywhere; }
.fridge-option-mark { flex-shrink: 0; color: var(--theme-accent-text, #994017); font-weight: 700; }
.fridge-option-checked { background: var(--theme-selected, #ffe8d5); border-color: var(--theme-selected-border, #e9a879); color: var(--theme-accent-text, #783414); }
.fridge-empty { padding: 30rpx 0; }
.fridge-more { display: block; margin: 14rpx auto 0; }

@import "../../styles/recipe-search.wxss";
@import "../../styles/recipe-card.wxss";

.fridge-fill { display: flex; flex-direction: column; height: 100vh; }
.fridge-fill .screen {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  width: 100%;
}

/* 顶部轮播灵感卡 */
.fridge-banner { flex: 0 0 auto; height: 232rpx; border-radius: var(--card-radius, 28rpx); overflow: hidden; }
.fridge-banner-slide {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 0;
  border-radius: var(--card-radius, 28rpx);
  overflow: hidden;
  background: var(--theme-tint-1, #f6d9a8);
  color: var(--theme-accent-text, #783414);
  text-align: left;
  line-height: 1.35;
}
.theme-green .fridge-banner-slide, .theme-blue .fridge-banner-slide { background: var(--theme-selected); }
.fridge-banner-pressed { opacity: .8; }
.fridge-banner-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.fridge-banner-copy { position: absolute; left: 28rpx; top: 56rpx; max-width: 62%; }
.fridge-banner-title { font-size: var(--fs-lg, 32rpx); font-weight: 700; line-height: 1.3; }
.fridge-banner-action { position: absolute; left: 28rpx; bottom: 24rpx; font-size: var(--fs-sm, 24rpx); font-weight: 600; }

.fridge-search-row { display: flex; align-items: center; gap: 16rpx; }
.fridge-search-row .recipe-search { flex: 1; min-width: 0; }
.fridge-cart {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 86rpx;
  height: 86rpx;
  border-radius: 22rpx;
  background: var(--theme-selected, #fbecdc);
}
.fridge-cart image { width: 40rpx; height: 40rpx; }
.fridge-cart-count {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  padding: 0 7rpx;
  border: 2rpx solid var(--theme-page-bg, #fff8f0);
  border-radius: 999rpx;
  background: var(--theme-accent-text, #994017);
  color: #fff;
  font-size: var(--fs-xs, 22rpx);
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}
.fridge-edit { flex: 1; display: flex; flex-direction: column; min-height: 0; margin-top: 24rpx; }
.recipe-search.fridge-search { margin-bottom: 0; border-radius: 22rpx; }
.fridge-search .search-mark { border-color: #75665e; }
.fridge-search .search-mark::after { background: #75665e; }
.fridge-picker-head {
  flex-shrink: 0;
  align-items: flex-start;
  margin-top: 20rpx;
  padding-bottom: 16rpx;
}
.fridge-groups {
  flex-shrink: 0;
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}
.fridge-group-track { display: inline-flex; gap: 8rpx; }
.fridge-group {
  flex-shrink: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: transparent;
  color: var(--theme-muted, #67554c);
  font-size: var(--fs-sm, 24rpx);
  line-height: 88rpx;
}
.fridge-group-active { background: var(--theme-selected, #ffe8d5); color: var(--theme-accent-text, #783414); font-weight: 700; }
.fridge-options-scroll { flex: 1; min-height: 0; height: 0; }
.fridge-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.fridge-option {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 14rpx;
  min-width: 0;
  min-height: 88rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 14rpx;
  background: var(--theme-soft, #fffaf5);
  color: var(--theme-text, #5d4037);
  font-size: var(--fs-md, 28rpx);
  line-height: 1.35;
  text-align: left;
}
/* 有插画的食材在名称左侧显示缩略图，尺寸跟行内容高度（64rpx）一致，不撑高行 */
.fridge-option-cover { flex: 0 0 64rpx; width: 64rpx; height: 64rpx; border-radius: 10rpx; overflow: hidden; }
.fridge-option-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fridge-option-mark { flex-shrink: 0; color: var(--theme-accent-text, #994017); font-weight: 700; }
.fridge-option-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  color: #75665e;
  font-size: var(--fs-xs, 22rpx);
  font-weight: 600;
  line-height: 1;
}
.fridge-option-checked { background: var(--theme-selected, #ffe8d5); border-color: var(--theme-selected-border, #e9a879); color: var(--theme-accent-text, #783414); }
.fridge-empty { padding: 30rpx 0; }
.fridge-more { display: block; margin: 14rpx auto 0; }
.fridge-inventory-note { margin-top: 2rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-xs, 22rpx); }
.fridge-clear { padding-right: 0; color: var(--state-danger, #c04040); font-size: var(--fs-sm, 24rpx); }

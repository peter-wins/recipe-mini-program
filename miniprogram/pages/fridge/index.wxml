<view class="theme-page theme-{{themeId}}">
  <view class="screen">
    <view class="fridge-card">
      <view class="row">
        <view>
          <view class="section">手边有 {{fridgeSummary.count}} 种食材</view>
          <view class="subtle">{{fridgeSummary.staples ? '另有 ' + fridgeSummary.staples + ' 样常备调料' : '点选食材即可登记'}}</view>
        </view>
        <navigator class="fridge-icon" url="/pages/shopping/index" aria-label="采购清单" hover-class="card-pressed"><image src="/assets/icon-cart.svg" aria-hidden="true"/></navigator>
      </view>
      <view wx:if="{{selected.length}}" class="fridge-picked">
        <block wx:for="{{selectedItems}}" wx:key="id">
          <button wx:if="{{showAllSelected || index < 8}}" class="fridge-picked-chip" data-id="{{item.id}}" bindtap="toggleIngredient" aria-label="移除{{item.name}}">{{item.name}}<text aria-hidden="true"> ×</text></button>
        </block>
        <button wx:if="{{selected.length > 8}}" class="fridge-expand" bindtap="toggleSelectedIngredients" aria-expanded="{{showAllSelected}}">{{showAllSelected ? '收起' : '还有 ' + (selected.length - 8) + ' 样'}}</button>
        <button wx:if="{{selected.length <= 8 || showAllSelected}}" class="fridge-clear" bindtap="clearInventory">清空</button>
      </view>
    </view>

    <view id="ingredient-picker" class="fridge-edit">
      <view class="recipe-search fridge-search">
        <view class="search-mark" aria-hidden="true"></view>
        <input class="recipe-search-input" value="{{search}}" bindinput="searchIngredients" confirm-type="search" placeholder="搜索食材，如 茄子、牛腩"/>
        <button wx:if="{{search}}" class="link" bindtap="clearIngredientSearch">清除</button>
      </view>

      <view class="row fridge-picker-head">
        <text class="section">{{searching ? '搜索结果' : '常用食材'}}</text>
      </view>
      <view class="fridge-picker-body">
        <scroll-view wx:if="{{!searching}}" class="fridge-groups" scroll-y enhanced show-scrollbar="{{false}}">
          <button wx:for="{{fridgeGroupNames}}" wx:key="*this" class="fridge-group {{fridgeGroupIndex === index ? 'fridge-group-active' : ''}}" data-index="{{index}}" bindtap="selectIngredientGroup" aria-pressed="{{fridgeGroupIndex === index}}">{{item}}</button>
        </scroll-view>
        <scroll-view class="fridge-options-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view wx:if="{{!visibleIngredients.length}}" class="empty fridge-empty">没找到这个食材，试试其他叫法。</view>
          <view wx:else class="fridge-options">
            <button wx:for="{{visibleIngredients}}" wx:key="id" class="fridge-option {{item.checked ? 'fridge-option-checked' : ''}}" data-id="{{item.id}}" bindtap="toggleIngredient" aria-pressed="{{item.checked}}">
              <text class="fridge-option-name">{{item.name}}</text>
              <text class="fridge-option-mark" aria-hidden="true">{{item.checked ? '✓' : '+'}}</text>
            </button>
          </view>
          <button wx:if="{{hasMoreIngredients}}" class="link fridge-more" bindtap="loadMoreIngredients">显示更多结果</button>
        </scroll-view>
      </view>
    </view>
  </view>
</view>

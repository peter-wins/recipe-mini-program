.recipe-search {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 86rpx;
  padding: 0 24rpx;
  border: 1rpx solid #f0e4d8;
  border-radius: 999rpx;
  background: #fff;
}
.search-mark {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  border: 3rpx solid #75665e;
  border-radius: 50%;
}
.search-mark::after {
  position: absolute;
  top: 21rpx;
  left: 20rpx;
  width: 12rpx;
  height: 3rpx;
  transform: rotate(45deg);
  transform-origin: left;
  background: #75665e;
  content: '';
}
.recipe-search-input { flex: 1; min-width: 0; height: 84rpx; font-size: 29rpx; }
.fridge-starter {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #f0e4d8;
  border-radius: 22rpx;
  background: #fff2e5;
}
.starter-heading { display: flex; align-items: center; gap: 16rpx; }
.starter-icon { display: flex; flex: 0 0 64rpx; align-items: center; justify-content: center; height: 64rpx; border-radius: 50%; background: #f9e2cb; }
.starter-icon image { width: 34rpx; height: 34rpx; }
.starter-title { margin-bottom: 4rpx; color: #5D4037; font-size: 34rpx; font-weight: 700; }
.starter-button { display: inline-block; margin-top: 18rpx; }
.discovery-heading { margin-top: 24rpx; min-height: 64rpx; padding-bottom: 10rpx; }
.match-group + .match-group { margin-top: 20rpx; }
.match-group-head { min-height: 64rpx; margin-bottom: 8rpx; }
.match-group-title { color: #75665e; font-size: 26rpx; font-weight: 650; }
.match-list-head { margin-bottom: 16rpx; }
.match-list-more { display: block; margin: 14rpx auto 0; }
.more-recipes-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 0 0 14rpx;
  background: transparent;
  color: #6B7280;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 64rpx;
}
.more-recipes-arrow { font-size: 27rpx; line-height: 1; }
.discovery-heading .link { line-height: 64rpx; }
.library-tabs { margin-top: 20rpx; }
.library-tab, .library-filter {
  flex-shrink: 0;
  padding: 0 22rpx;
  border: 1rpx solid #f0e4d8;
  border-radius: 999rpx;
  background: #fff;
  color: #5D4037;
  font-size: 26rpx;
  line-height: 68rpx;
  white-space: nowrap;
}
.library-selected { border-color: #e3a67b; background: #ffe3ca; color: #994017; font-weight: 650; }
.library-toolbar { flex-wrap: wrap; margin-top: 24rpx; gap: 10rpx; }
.library-count { color: #5D4037; font-size: 29rpx; font-weight: 700; }
.library-filters { display: flex; flex-wrap: wrap; gap: 10rpx; }
.library-applied { margin-top: 8rpx; color: #75665e; font-size: 24rpx; }
.library-applied .more-recipes-link { flex-shrink: 0; }
.library-grid { margin-top: 16rpx; }
.library-empty .link { display: block; margin: 6rpx auto 0; }
.category-scroll { width: 100%; white-space: nowrap; }
.category-track { display: inline-flex; gap: 12rpx; padding-right: 6rpx; }
/* ---------- 问候区 ---------- */
.home-greeting { margin: 4rpx 2rpx 14rpx; }
.greeting-line { display: flex; align-items: center; gap: 12rpx; }
.greeting-text { font-size: 36rpx; font-weight: 750; color: #5D4037; }
.greeting-festival {
  flex-shrink: 0;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  background: #ffe3ca;
  color: #994017;
  font-size: 23rpx;
  font-weight: 650;
}
.greeting-date { margin-left: auto; color: #a08c7c; font-size: 24rpx; }
.greeting-quote { margin-top: 6rpx; color: #75665e; font-size: 26rpx; }

.feature-banner {
  position: relative;
  display: block;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 1rpx solid #f0e4d8;
  background: #fff;
  color: #5D4037;
}
.feature-image { display: block; width: 100%; height: 316rpx; }
.banner-caption { position: relative; padding: 62rpx 64rpx 22rpx 24rpx; }
.feature-with-photo .banner-caption { padding-top: 20rpx; }
.feature-title { margin: 0 0 6rpx; font-size: 37rpx; font-weight: 750; line-height: 1.25; }
.banner-meta { color: #75665e; font-size: 26rpx; }
.feature-reason { margin-top: 6rpx; color: #994017; font-size: 26rpx; font-weight: 600; }
.feature-arrow { position: absolute; top: 50%; right: 24rpx; transform: translateY(-50%); color: #a57455; font-size: 38rpx; }
.feature-badge {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 5rpx;
  top: 20rpx;
  right: 20rpx;
  z-index: 1;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  background: #FF8A3D;
  color: #43251b;
  font-size: 23rpx;
  font-weight: 650;
}
.feature-badge-icon { font-size: 20rpx; line-height: 1; }
.missing-list { overflow: hidden; border: 1rpx solid #f0e4d8; border-radius: 20rpx; background: #fff; }
.missing-thumb { display: block; flex-shrink: 0; width: 76rpx; height: 76rpx; overflow: hidden; border-radius: 12rpx; background: #f4e5d7; }
.missing-thumb-empty { display: flex; align-items: center; justify-content: center; }
.missing-thumb-empty image { width: 34rpx; height: 34rpx; }
.missing-row { display: flex; align-items: center; gap: 14rpx; min-height: 94rpx; padding: 12rpx 22rpx; box-sizing: border-box; }
.missing-row + .missing-row { border-top: 1rpx solid #f0e4d8; }
.missing-dish { flex: 1; min-width: 0; }
.missing-name { font-size: 30rpx; font-weight: 650; }
.missing-label { max-width: 42%; color: #994017; font-size: 26rpx; text-align: right; }
.missing-arrow { color: #a57455; font-size: 33rpx; }
.discovery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.discovery-tile { overflow: hidden; border: 1rpx solid #f0e4d8; border-radius: 20rpx; background: #fff; }
.discovery-photo { display: block; width: 100%; height: 192rpx; background: #f4e5d7; }
.discovery-no-photo { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; color: #75665e; font-size: 25rpx; }
.discovery-no-photo image { width: 44rpx; height: 44rpx; }
.discovery-body { padding: 16rpx 18rpx; }
.discovery-name { overflow: hidden; font-size: 31rpx; font-weight: 700; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.discovery-meta { margin-top: 4rpx; color: #75665e; font-size: 24rpx; }
.card-facts, .card-fact { display: flex; align-items: center; }
.card-facts { justify-content: space-between; gap: 8rpx; }
.card-fact { gap: 6rpx; white-space: nowrap; }
.fact-clock {
  position: relative;
  flex-shrink: 0;
  width: 19rpx;
  height: 19rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}
.fact-clock::after {
  position: absolute;
  top: 2rpx;
  left: 6rpx;
  width: 4rpx;
  height: 6rpx;
  border-left: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: '';
}
.difficulty-dot { flex-shrink: 0; width: 12rpx; height: 12rpx; border-radius: 50%; background: #59a16b; }
.difficulty-medium { background: #c99b39; }
.main-nav {
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8rpx 24rpx 10rpx;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0e4d8;
  border-radius: 0;
  background: #fff;
  box-shadow: none;
}
.main-nav .nav-inner { align-items: center; gap: 0; }
.main-nav .nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 92rpx;
  gap: 4rpx;
  border-radius: 0;
  font-size: 23rpx;
  line-height: 1.2;
}
.main-nav .nav-item image { width: 34rpx; height: 34rpx; }
.main-nav .nav-current { background: transparent; color: #994017; }
.main-nav .nav-current image { filter: brightness(.68) sepia(.8) saturate(4); }
.profile-head { display: flex; align-items: center; gap: 22rpx; margin: 14rpx 0 28rpx; }
.profile-avatar { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; border-radius: 50%; background: #e98034; }
.profile-avatar image { width: 56rpx; height: 56rpx; }
.profile-name { color: #5D4037; font-size: 35rpx; font-weight: 700; }
.profile-stats { display: flex; align-items: center; padding: 22rpx 0; border-radius: 23rpx; background: linear-gradient(115deg, #ffab63, #FF8A3D); color: #43251b; }
.profile-stat { flex: 1; min-width: 0; padding: 7rpx 0; border-radius: 0; background: transparent; font-size: 24rpx; line-height: 1.4; text-align: center; }
.profile-stat + .profile-stat { border-left: 1rpx solid rgba(93, 64, 55, .28); }
.stat-count { display: block; font-size: 39rpx; font-weight: 750; }
.profile-links { margin-top: 28rpx; overflow: hidden; border-radius: 23rpx; background: #fff; }
.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 94rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  border-radius: 0;
  background: #fff;
  color: #5D4037;
  font-size: 28rpx;
  text-align: left;
}
.profile-row + .profile-row { border-top: 1rpx solid #f0e4d8; }
.profile-row image { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.profile-row .chef-list-icon { box-sizing: border-box; padding: 4rpx; border-radius: 50%; background: #a35a36; }
.profile-arrow { margin-left: auto; color: #75665e; font-size: 33rpx; }

/* ---------- 食材页 ---------- */
.fridge-card, .fridge-picker {
  padding: 24rpx;
  border: 1rpx solid #f0e4d8;
  border-radius: 24rpx;
  background: #fff;
}
.fridge-card-head, .fridge-picker-head { display: flex; align-items: center; gap: 16rpx; }
.fridge-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: #ffeddf;
}
.fridge-icon image { width: 36rpx; height: 36rpx; }
.fridge-card-copy { flex: 1; min-width: 0; }
.fridge-title { color: #43251b; font-size: 32rpx; font-weight: 750; line-height: 1.3; }
.fridge-count, .fridge-hint, .fridge-picker-note { color: #75665e; font-size: 25rpx; }
.fridge-count { margin-top: 6rpx; }
.fridge-hint { margin-top: 18rpx; }
.fridge-go {
  flex-shrink: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffeddf;
  color: #994017;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 64rpx;
}
.fridge-picked {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0e4d8;
}
.fridge-picked-chip, .fridge-expand, .fridge-clear {
  max-width: 100%;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff2e8;
  color: #803c1e;
  font-size: 24rpx;
  line-height: 58rpx;
  overflow-wrap: anywhere;
}
.fridge-picked-chip text { margin-left: 4rpx; }
.fridge-expand { background: #f7f3ee; color: #67554c; }
.fridge-clear { background: transparent; color: #75665e; }
.fridge-search { margin: 20rpx 0; }
.fridge-picker-head { justify-content: space-between; margin-bottom: 18rpx; }
.fridge-tabs { width: 100%; margin-bottom: 18rpx; }
.fridge-tabs-track { display: inline-flex; gap: 10rpx; white-space: nowrap; }
.fridge-tab {
  flex-shrink: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f7f3ee;
  color: #67554c;
  font-size: 24rpx;
  line-height: 58rpx;
}
.fridge-tab-active { background: #ffdfc7; color: #783414; font-weight: 700; }
.fridge-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.fridge-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  min-width: 0;
  min-height: 76rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid #f0e4d8;
  border-radius: 14rpx;
  background: #fffaf5;
  color: #5d4037;
  font-size: 27rpx;
  line-height: 1.35;
  text-align: left;
}
.fridge-option-name { min-width: 0; overflow-wrap: anywhere; }
.fridge-option-mark { flex-shrink: 0; color: #994017; font-weight: 700; }
.fridge-option-checked { background: #ffe8d5; border-color: #e9a879; color: #783414; }
.fridge-empty { padding: 30rpx 0; }
.fridge-more { display: block; margin: 14rpx auto 0; }

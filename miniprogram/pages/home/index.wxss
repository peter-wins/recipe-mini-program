@import "../../styles/recipe-search.wxss";
@import "../../styles/recipe-card.wxss";

button.home-search {
  width: 100%;
  min-height: 88rpx;
  margin-top: 34rpx;
  overflow: hidden;
  border-color: var(--theme-border, #efdfd1);
  border-radius: 26rpx;
  background: #fffdfa;
  color: var(--theme-muted, #75665e);
  font-size: 28rpx;
  line-height: 1.4;
  text-align: left;
  font-weight: 400;
}
.screen.home-screen { padding-top: 28rpx; }
.more-recipes-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 0 0 14rpx;
  background: transparent;
  color: var(--theme-muted, #75665e);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 64rpx;
}
.more-recipes-arrow { font-size: 27rpx; line-height: 1; }
.library-header { margin: 12rpx 0 28rpx; }
.library-header-copy { min-width: 0; }
.library-ai {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 18rpx;
  background: var(--theme-soft, #fff0e5);
  border: 1rpx solid var(--theme-border, #eadfd4);
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 62rpx;
  white-space: nowrap;
}
.library-ai image { width: 27rpx; height: 27rpx; }
.library-eyebrow { color: var(--theme-muted, #75665e); font-size: 25rpx; }
.library-title { margin-top: 8rpx; color: var(--theme-text, #4e342c); font-size: 50rpx; font-weight: 750; line-height: 1.2; }
.recipe-search.library-search { border-radius: 26rpx; }
.library-scenes {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  overflow-x: auto;
  scrollbar-width: none;
}
.library-scene {
  flex-shrink: 0;
  min-height: 60rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--theme-border, #eadfd4);
  border-radius: 30rpx;
  background: transparent;
  color: var(--theme-muted, #75665e);
  font-size: 27rpx;
  line-height: 56rpx;
}
.library-scene-active {
  border-color: var(--theme-accent, #c87137);
  background: var(--theme-accent, #c87137);
  color: #fff;
}
.library-toolbar { flex-wrap: wrap; margin-top: 20rpx; gap: 4rpx 12rpx; }
.library-filters { display: flex; flex-wrap: wrap; gap: 0 14rpx; margin-left: auto; }
.library-category-picker { flex-shrink: 0; }
.library-category-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  padding-left: 12rpx;
  color: var(--theme-muted, #75665e);
  font-size: 26rpx;
}
.library-category-active { color: var(--theme-accent-text, #994017); font-weight: 650; }
.library-category-arrow {
  width: 10rpx;
  height: 10rpx;
  margin: -5rpx 3rpx 0 0;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
}
.library-grid { margin-top: 16rpx; }
.library-load-more { display: block; margin: 18rpx auto 0; }
/* ---------- 问候区 ---------- */
.home-greeting { margin: 12rpx 0 38rpx; }
.greeting-quote { color: var(--theme-muted, #75665e); font-size: 25rpx; line-height: 1.4; }
.home-title-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.home-heading-copy { flex: 1; min-width: 0; }
.home-title {
  margin-top: 12rpx;
  color: var(--theme-text, #43251b);
  font-size: 51rpx;
  font-weight: 800;
  line-height: 1.2;
}
.home-wok { position: relative; flex: 0 0 116rpx; height: 72rpx; }
.wok-pan {
  position: absolute;
  left: 4rpx;
  bottom: 3rpx;
  width: 72rpx;
  height: 24rpx;
  border-radius: 4rpx 4rpx 40rpx 40rpx;
  background: var(--theme-text, #654639);
  transform-origin: 85% 12%;
  animation: wok-tilt 4s ease-in-out infinite;
}
.wok-pan::after {
  position: absolute;
  right: -35rpx;
  top: 2rpx;
  width: 39rpx;
  height: 7rpx;
  border-radius: 6rpx;
  background: inherit;
  transform: rotate(-15deg);
  transform-origin: left center;
  content: '';
}
.wok-vegetables {
  position: absolute;
  left: 16rpx;
  bottom: 23rpx;
  display: flex;
  align-items: flex-end;
  gap: 5rpx;
  animation: wok-toss 4s ease-in-out infinite;
}
.wok-vegetables view { width: 13rpx; height: 10rpx; border-radius: 6rpx 9rpx 4rpx 7rpx; background: #7f9c69; }
.wok-vegetables view:nth-child(2) { height: 13rpx; background: #db945c; }
.wok-vegetables view:nth-child(3) { height: 8rpx; background: #d2ad65; }
.wok-steam {
  position: absolute;
  left: 36rpx;
  top: 19rpx;
  width: 9rpx;
  height: 14rpx;
  border-left: 2rpx solid var(--theme-muted, #887366);
  border-radius: 50%;
  opacity: .42;
  animation: wok-steam-rise 4s ease-out infinite;
}
.wok-steam::after {
  position: absolute;
  left: 13rpx;
  top: 4rpx;
  width: 7rpx;
  height: 11rpx;
  border-left: 2rpx solid var(--theme-muted, #887366);
  border-radius: 50%;
  content: '';
}

@keyframes wok-tilt {
  0%, 34%, 100% { transform: rotate(0); }
  12% { transform: rotate(-12deg); }
  23% { transform: rotate(7deg); }
}
@keyframes wok-toss {
  0%, 34%, 100% { transform: translate(0, 0) rotate(0); }
  13% { transform: translate(6rpx, -23rpx) rotate(-22deg); }
  22% { transform: translate(4rpx, -15rpx) rotate(15deg); }
}
@keyframes wok-steam-rise {
  0%, 30%, 79%, 100% { opacity: 0; transform: translateY(0); }
  47% { opacity: .45; }
  78% { opacity: 0; transform: translateY(-17rpx); }
}
@media (prefers-reduced-motion: reduce) {
  .wok-pan, .wok-vegetables, .wok-steam { animation: none; }
}

.feature-banner {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 244rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: 36rpx;
  background: var(--theme-placeholder, #f4e5d7);
  color: var(--theme-text, #5D4037);
}
.feature-with-photo { min-height: 455rpx; color: #fff; }
.feature-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.banner-caption { position: relative; padding: 30rpx 32rpx 32rpx; }
.feature-with-photo .banner-caption {
  padding-top: 84rpx;
  background: linear-gradient(to bottom, transparent, rgba(27, 20, 16, .74) 65%, rgba(27, 20, 16, .9));
}
.feature-title { margin-top: 12rpx; font-size: 43rpx; font-weight: 750; line-height: 1.2; }
.feature-meta { margin-top: 10rpx; font-size: 26rpx; }
.feature-badge {
  display: inline-block;
  padding: 6rpx 17rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-accent-text, #96512f);
  font-size: 22rpx;
  font-weight: 650;
  white-space: nowrap;
}
.home-shortcuts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8rpx; padding: 36rpx 0 38rpx; }
.home-dinner-card {
  display: block;
  padding: 22rpx 24rpx 24rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.home-dinner-heading { gap: 14rpx; }
.home-dinner-link { flex-shrink: 0; color: var(--theme-accent-text, #994017); font-size: 24rpx; }
.home-dinner-body { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; }
.home-dinner-cover { flex: 0 0 132rpx; height: 132rpx; overflow: hidden; border-radius: 18rpx; }
.home-dinner-copy { min-width: 0; }
.home-dinner-title { font-size: 30rpx; font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }
.home-dinner-dishes { margin-top: 6rpx; font-size: 24rpx; line-height: 1.45; overflow-wrap: anywhere; }
.home-shortcut {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  padding: 0;
  background: transparent;
  color: var(--theme-text, #5d4037);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.5;
  text-align: center;
}
.shortcut-icon { display: flex; align-items: center; justify-content: center; width: 94rpx; height: 94rpx; border-radius: 30rpx; }
.shortcut-icon image { width: 36rpx; height: 36rpx; }
.shortcut-shopping { position: relative; background: #f2e6d2; }
.shortcut-shopping-count {
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  box-sizing: border-box;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 7rpx;
  border: 2rpx solid var(--theme-page-bg, #fff8f0);
  border-radius: 999rpx;
  background: var(--theme-accent-text, #994017);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  white-space: nowrap;
}
.shortcut-fridge { background: #e4ecdf; }
.shortcut-calendar { background: #f2e6dd; color: var(--theme-accent-text, #994017); }
.shortcut-calendar .meal-calendar-icon { flex-basis: 36rpx; height: 33rpx; }
.shortcut-random { background: #eee6ec; }
.home-fridge { padding-top: 36rpx; border-top: 1rpx solid var(--theme-border, #e8d8cb); }
.home-fridge-heading { min-height: 58rpx; }
.home-fridge-heading .section { font-size: 36rpx; font-weight: 750; line-height: 1.3; }
.home-fridge-link { flex-shrink: 0; color: var(--theme-accent-text, #96512f); font-size: 23rpx; }
.home-fridge-description { margin: 2rpx 0 14rpx; color: var(--theme-muted, #75665e); font-size: 25rpx; line-height: 1.45; }
.home-fridge-empty { margin-top: 10rpx; color: var(--theme-muted, #75665e); font-size: 26rpx; }
.home-fridge-empty .link { display: block; margin-top: 6rpx; padding-left: 0; }
.discovery-grid.home-match-grid { margin-top: 18rpx; row-gap: 28rpx; }
.home-inspiration { margin-top: 46rpx; }
.collection-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  padding: 22rpx;
  border-radius: 30rpx;
  background: var(--theme-neutral, #f0e6d8);
  color: var(--theme-text, #4e342c);
  line-height: 1.45;
  text-align: left;
}
.collection-banner-light { margin-top: 12rpx; box-sizing: border-box; }
.collection-photo {
  display: block;
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 106rpx;
  overflow: hidden;
  border-radius: 18rpx;
}
.collection-banner-light.pressed { background: var(--theme-soft, #fff3e8); }
.collection-copy { flex: 1; min-width: 0; }
.collection-title { font-size: 30rpx; font-weight: 700; }
.collection-description { margin-top: 6rpx; color: var(--theme-muted, #75665e); font-size: 24rpx; }
.collection-arrow { flex-shrink: 0; color: var(--theme-accent-text, #a16a45); font-size: 36rpx; }
.main-nav {
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8rpx 24rpx 10rpx;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 0;
  background: #fff;
  box-shadow: none;
}
.main-nav .nav-inner { align-items: center; gap: 0; }
.main-nav .nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 92rpx;
  gap: 4rpx;
  border-radius: 0;
  font-size: 23rpx;
  line-height: 1.2;
}
.main-nav .nav-item image { width: 34rpx; height: 34rpx; }
.main-nav .nav-current { background: transparent; color: var(--theme-accent-text, #994017); }
.main-nav .nav-current image { filter: var(--theme-nav-icon, brightness(.68) sepia(.8) saturate(4)); }
.profile-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 12rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: var(--theme-neutral, #f1e6d9);
}
.profile-avatar {
  display: flex;
  flex: 0 0 102rpx;
  align-items: center;
  justify-content: center;
  height: 102rpx;
  border-radius: 28rpx;
  background: var(--theme-soft, #fff8ef);
  font-size: 52rpx;
  line-height: 1;
}
.profile-copy { flex: 1; min-width: 0; }
.profile-name { color: var(--theme-text, #4e342c); font-size: 34rpx; font-weight: 700; line-height: 1.3; }
.profile-note { margin-top: 9rpx; color: var(--theme-muted, #75665e); font-size: 24rpx; }
.profile-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 20rpx 0 26rpx; }
.profile-stat { padding: 10rpx 4rpx; border-radius: 16rpx; color: var(--theme-muted, #75665e); font-size: 23rpx; line-height: 1.4; text-align: center; }
.profile-stat + .profile-stat { border-left: 1rpx solid var(--theme-border, #f0e4d8); }
.stat-count { display: block; margin-bottom: 4rpx; color: var(--theme-text, #4e342c); font-size: 44rpx; font-weight: 750; line-height: 1.2; }
.profile-links { overflow: hidden; padding: 4rpx 24rpx; border-radius: 30rpx; background: #fff; }
.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 92rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 0;
  background: #fff;
  color: var(--theme-text, #5D4037);
  font-size: 28rpx;
  text-align: left;
}
.profile-row + .profile-row { border-top: 1rpx solid var(--theme-border, #f0e4d8); }
.profile-row image { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.profile-hint { max-width: 340rpx; margin-left: auto; overflow: hidden; color: var(--theme-muted, #75665e); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.profile-arrow { flex-shrink: 0; margin-left: 8rpx; color: var(--theme-muted, #75665e); font-size: 33rpx; }

.profile-themes {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: #fff;
}
.profile-themes-title { margin-bottom: 16rpx; font-size: 30rpx; font-weight: 700; }
.profile-version { margin: 26rpx 0 12rpx; padding: 26rpx 28rpx; border-radius: 30rpx; background: #fff; }
.profile-version-head { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx; }
.profile-version-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-accent-text, #994017);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.6;
}
.profile-version-title { color: var(--theme-text, #4e342c); font-size: 28rpx; font-weight: 700; }
.profile-version-note {
  position: relative;
  padding-left: 24rpx;
  color: var(--theme-muted, #75665e);
  font-size: 23rpx;
  line-height: 1.95;
}
.profile-version-note::before {
  content: '';
  position: absolute;
  top: 19rpx;
  left: 4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--theme-accent-text, #994017);
}
.theme-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.theme-option {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  padding: 12rpx 6rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 14rpx;
  background: #fff;
  font-size: 25rpx;
  line-height: 1.4;
}
.theme-option-selected {
  border-color: var(--theme-selected-border, #f2b28a);
  background: var(--theme-soft, #fff5eb);
  color: var(--theme-accent-text, #994017);
  font-weight: 650;
}
.theme-swatch { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 42rpx; border-radius: 10rpx; }
.theme-swatch-dot { width: 22rpx; height: 22rpx; border-radius: 50%; }
.theme-option-check { position: absolute; top: 6rpx; right: 10rpx; font-size: 22rpx; }

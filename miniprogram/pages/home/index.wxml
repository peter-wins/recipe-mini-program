<wxs src="../../icons.wxs" module="icons" />
<import src="../../templates/recipe-card.wxml"/>

<template name="homeFeature">
  <navigator wx:if="{{recipe}}" class="feature-banner {{recipe.image ? 'feature-with-photo' : ''}}" url="/pages/recipe/index?id={{recipe.id}}" hover-class="feature-tap" aria-label="{{recipe.name + '，看做法'}}">
    <recipe-cover wx:if="{{recipe.image}}" class="feature-image" src="{{recipe.image}}"/>
    <view class="banner-caption">
      <text class="feature-badge">{{isRecommended ? '今日灵感' : '快手菜'}}</text>
      <view class="feature-title">{{recipe.name}}</view>
      <view class="feature-meta">{{recipe.timeText}} · {{recipe.difficulty}}</view>
    </view>
  </navigator>
</template>

<view class="theme-page theme-{{themeId}}">
<view class="screen has-nav {{view === 'match' ? 'home-screen' : ''}}">
  <block wx:if="{{view === 'match'}}">
    <view class="home-greeting">
      <view class="home-title-row">
        <view class="home-heading-copy">
          <view class="home-title">今天想吃点什么？</view>
          <view class="greeting-quote">{{greeting.quoteText}}</view>
        </view>
        <view class="home-wok" aria-hidden="true">
          <view class="wok-steam"></view>
          <view class="wok-vegetables"><view></view><view></view><view></view></view>
          <view class="wok-pan"></view>
        </view>
      </view>
      <button class="recipe-search home-search" bindtap="openRecipeSearch">
        <view class="search-mark" aria-hidden="true"></view>
        <text>搜索菜谱、食材</text>
      </button>
    </view>
    <navigator wx:if="{{tonightMeal}}" class="home-dinner-card" url="/pages/meal-calendar/index?date={{tonightMeal.date}}" hover-class="card-pressed" aria-label="今晚菜单，查看做饭日历">
      <view class="row home-dinner-heading">
        <text class="section">今晚菜单</text>
        <text class="home-dinner-link">查看日历 ›</text>
      </view>
      <view class="home-dinner-body">
        <recipe-cover wx:if="{{tonightMeal.image}}" class="home-dinner-cover" src="{{tonightMeal.image}}"/>
        <view class="home-dinner-copy">
          <view class="home-dinner-title">{{tonightMeal.title}}</view>
          <view wx:if="{{tonightMeal.names}}" class="subtle home-dinner-dishes">{{tonightMeal.names}}</view>
        </view>
      </view>
    </navigator>
    <template wx:else is="homeFeature" data="{{recipe: featured || quickRecipe, isRecommended: !!featured}}"/>
    <view class="home-shortcuts">
      <button class="home-shortcut" bindtap="openFridge">
        <view class="shortcut-icon shortcut-fridge"><image src="{{icons.path('fridge')}}" aria-hidden="true"/></view>
        <text>我的冰箱</text>
      </button>
      <button class="home-shortcut" bindtap="openSurprise">
        <view class="shortcut-icon shortcut-random"><image src="{{icons.path('shuffle')}}" aria-hidden="true"/></view>
        <text>随机吃</text>
      </button>
      <navigator class="home-shortcut" url="/pages/meal-calendar/index" hover-class="pressed">
        <view class="shortcut-icon shortcut-calendar"><image src="{{icons.path('calendar')}}" aria-hidden="true"/></view>
        <text>做饭日历</text>
      </navigator>
      <navigator class="home-shortcut" url="/pages/shopping/index" hover-class="pressed" aria-label="{{shoppingCount ? '采购清单，待买' + shoppingCount + '项' : '采购清单'}}">
        <view class="shortcut-icon shortcut-shopping">
          <image src="{{icons.path('cart')}}" aria-hidden="true"/>
          <text wx:if="{{shoppingCount}}" class="shortcut-shopping-count" aria-hidden="true">{{shoppingCount > 99 ? '99+' : shoppingCount}}</text>
        </view>
        <text>采购清单</text>
      </navigator>
    </view>

    <view class="home-fridge">
      <view class="row home-fridge-heading">
        <text class="section">冰箱里的食材能做什么</text>
        <button wx:if="{{selected.length}}" class="more-recipes-link home-fridge-link" bindtap="openFridgeMatches">浏览更多 <text class="more-recipes-arrow" aria-hidden="true">›</text></button>
      </view>
      <view wx:if="{{selected.length}}" class="home-fridge-description">根据你登记的食材，找到今天的好选择</view>
      <view wx:if="{{homeMatches.length}}" class="discovery-grid home-match-grid">
        <template wx:for="{{homeMatches}}" wx:key="id" is="discoveryTile" data="{{recipe: item, showStock: true}}"/>
      </view>
      <view wx:else class="home-fridge-empty">
        <text>{{selected.length ? (featured ? '补充冰箱食材，看看还能做什么。' : '目前的食材还凑不出一道合适的菜。') : '选几样手边食材，看看今晚能做什么。'}}</text>
        <button class="link" bindtap="openFridge">{{selected.length ? '补充食材' : '添加食材'}}</button>
      </view>
    </view>
    <view wx:if="{{suggestedRecipes.length}}" class="home-inspiration">
      <view class="row home-fridge-heading">
        <text class="section">猜你喜欢</text>
        <button class="more-recipes-link home-fridge-link" bindtap="openAllRecipes">全部菜谱 <text class="more-recipes-arrow" aria-hidden="true">›</text></button>
      </view>
      <view class="discovery-grid home-match-grid">
        <template wx:for="{{suggestedRecipes}}" wx:key="id" is="discoveryTile" data="{{recipe: item, showStock: !!selected.length}}"/>
      </view>
    </view>
    <view class="home-inspiration">
      <view class="row home-fridge-heading">
        <text class="section">减脂轻食</text>
        <button class="more-recipes-link home-fridge-link" bindtap="openFatLossRecipes">浏览更多 <text class="more-recipes-arrow" aria-hidden="true">›</text></button>
      </view>
      <navigator wx:if="{{lightInspiration}}" class="collection-banner collection-banner-light" url="/pages/recipe/index?id={{lightInspiration.id}}" hover-class="pressed">
        <recipe-cover class="collection-photo" src="{{lightInspiration.image}}" lazy="{{true}}"/>
        <view class="collection-copy">
          <view class="collection-title">{{lightInspiration.name}}</view>
          <view class="collection-description">{{lightInspiration.minutes}} 分钟 · {{lightInspiration.difficulty}}</view>
        </view>
        <text class="collection-arrow" aria-hidden="true">›</text>
      </navigator>
    </view>
  </block>

  <block wx:elif="{{view === 'library'}}">
    <view class="row library-header">
      <view class="library-header-copy">
        <view class="library-title">菜谱灵感</view>
        <view class="library-subtitle">好味道，慢慢发现</view>
      </view>
      <button class="link library-ai" bindtap="showAiDevelopment">
        <image src="{{icons.path('sparkles')}}" aria-hidden="true"/>
        <text>问问 AI</text>
      </button>
    </view>
    <view class="recipe-search library-search">
      <view class="search-mark" aria-hidden="true"></view>
      <input class="recipe-search-input" value="{{librarySearch}}" focus="{{librarySearchFocused}}" bindinput="searchLibrary" bindblur="blurLibrarySearch" confirm-type="search" placeholder="搜菜名或食材"/>
      <button wx:if="{{librarySearch}}" class="link" bindtap="clearLibrarySearch">清除</button>
    </view>
    <view class="library-scenes">
      <button wx:for="{{sceneTags}}" wx:key="*this" class="library-scene {{tagIndex === index ? 'library-scene-active' : ''}}" data-index="{{index}}" bindtap="selectSceneTag" aria-pressed="{{tagIndex === index}}">{{item}}</button>
    </view>
    <view class="row library-toolbar">
      <text class="section">{{librarySearch || categoryIndex || tagIndex || methodIndex ? '找到 ' : '共 '}}{{results.length}} 道菜</text>
      <view class="library-filters">
        <picker class="library-category-picker" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="changeCategory" aria-label="菜谱分类，当前{{categories[categoryIndex]}}">
          <view class="library-category-label {{categoryIndex ? 'library-category-active' : ''}}">
            <text>{{categories[categoryIndex]}}</text>
            <view class="library-category-arrow" aria-hidden="true"></view>
          </view>
        </picker>
        <picker class="library-category-picker" mode="selector" range="{{methodTags}}" value="{{methodIndex}}" bindchange="changeCookMethod" aria-label="烹饪方式，当前{{methodTags[methodIndex]}}">
          <view class="library-category-label {{methodIndex ? 'library-category-active' : ''}}">
            <text>{{methodTags[methodIndex]}}</text>
            <view class="library-category-arrow" aria-hidden="true"></view>
          </view>
        </picker>
      </view>
    </view>
    <view wx:if="{{!results.length}}" class="empty">没有找到符合条件的菜谱。</view>
    <view wx:else class="discovery-grid library-grid">
      <template wx:for="{{libraryCards}}" wx:key="id" is="discoveryTile" data="{{recipe: item, showNutrition: (tagIndex || methodIndex) && !!item.nutrition}}"/>
    </view>
    <button wx:if="{{libraryCards.length < results.length}}" class="link library-load-more" bindtap="loadMoreRecipes">加载更多</button>
  </block>

  <meal-pairings wx:elif="{{view === 'meals'}}" id="meal-pairings" inventory="{{selected}}" inventory-ready="{{inventoryReady}}" calendar-date="{{calendarDate}}" calendar-slot="{{calendarSlot}}"/>

  <block wx:elif="{{view === 'profile'}}">
    <view class="profile-head">
      <view class="profile-avatar" aria-hidden="true"><image src="{{icons.path('chef')}}"/></view>
      <view class="profile-copy">
        <view class="profile-name">吃饭得有谱</view>
        <view class="profile-note">把每一餐，都过成喜欢的样子。</view>
      </view>
    </view>
    <view class="profile-stats">
      <navigator class="profile-stat" url="/pages/records/index?type=favorites" hover-class="card-pressed"><text class="stat-count">{{favorites.length}}</text>我的收藏</navigator>
      <navigator class="profile-stat" url="/pages/records/index?type=history" hover-class="card-pressed"><text class="stat-count">{{history.length}}</text>浏览历史</navigator>
      <navigator class="profile-stat" url="/pages/records/index?type=cooked" hover-class="card-pressed"><text class="stat-count">{{cooked.length}}</text>烹饪记录</navigator>
    </view>

    <view class="profile-group-title">我的厨房</view>
    <view class="profile-links">
      <button class="profile-row" bindtap="openFridge">
        <image src="{{icons.path('fridge')}}" aria-hidden="true"/>
        <view class="profile-row-copy"><view class="profile-row-title">冰箱食材</view><view class="profile-row-desc">随手记下家里的食材</view></view>
        <text class="profile-arrow">›</text>
      </button>
      <navigator class="profile-row" url="/pages/shopping/index" hover-class="pressed">
        <image src="{{icons.path('cart')}}" aria-hidden="true"/>
        <view class="profile-row-copy"><view class="profile-row-title">采购清单</view><view class="profile-row-desc">买菜不遗漏<text wx:if="{{shoppingCount}}" class="profile-row-count">，待买 {{shoppingCount}} 项</text></view></view>
        <text class="profile-arrow">›</text>
      </navigator>
      <navigator class="profile-row" url="/pages/meal-calendar/index" hover-class="pressed">
        <image src="{{icons.path('calendarLine')}}" aria-hidden="true"/>
        <view class="profile-row-copy"><view class="profile-row-title">做饭日历</view><view class="profile-row-desc">安排每天吃什么</view></view>
        <text class="profile-arrow">›</text>
      </navigator>
      <navigator class="profile-row" url="/pages/guide/index" hover-class="pressed">
        <image src="{{icons.path('guideSpinach')}}" aria-hidden="true"/>
        <view class="profile-row-copy"><view class="profile-row-title">食材指南</view><view class="profile-row-desc">认识食材，做对菜</view></view>
        <text class="profile-arrow">›</text>
      </navigator>
    </view>

    <view class="profile-group-title">偏好与设置</view>
    <view class="profile-links">
      <navigator class="profile-row" url="/pages/appearance/index" hover-class="pressed">
        <image src="{{icons.path('theme')}}" aria-hidden="true"/>
        <view class="profile-row-copy"><view class="profile-row-title">主题外观</view></view>
        <text class="profile-hint">{{themeName}}</text><text class="profile-arrow">›</text>
      </navigator>
      <button class="profile-row" open-type="contact">
        <image src="{{icons.path('feedback')}}" aria-hidden="true"/>
        <view class="profile-row-copy"><view class="profile-row-title">意见反馈</view></view>
        <text class="profile-arrow">›</text>
      </button>
      <navigator class="profile-row" url="/pages/about/index" hover-class="pressed">
        <image src="{{icons.path('info')}}" aria-hidden="true"/>
        <view class="profile-row-copy"><view class="profile-row-title">关于</view></view>
        <text class="profile-hint">{{versionLabel}}</text><text class="profile-arrow">›</text>
      </navigator>
    </view>

    <view class="profile-footer">吃饭得有谱 · 让每一餐都有好心情</view>
  </block>

</view>

<view class="bottom-nav main-nav">
  <view class="nav-inner">
    <button class="nav-item {{view === 'match' ? 'nav-current' : ''}}" data-view="match" bindtap="switchView"><image src="{{icons.path('home')}}" aria-hidden="true"/>首页</button>
    <button class="nav-item {{view === 'library' ? 'nav-current' : ''}}" data-view="library" bindtap="switchView"><image src="{{icons.path('cookbook')}}" aria-hidden="true"/>菜谱</button>
    <button class="nav-item {{view === 'meals' ? 'nav-current' : ''}}" data-view="meals" bindtap="switchView"><image src="{{icons.path('lightMeal')}}" aria-hidden="true"/>搭配</button>
    <button class="nav-item {{view === 'profile' ? 'nav-current' : ''}}" data-view="profile" bindtap="switchView"><image src="{{icons.path('profile')}}" aria-hidden="true"/>我的</button>
  </view>
</view>
</view>

<import src="../../templates/recipe-card.wxml"/>

<template name="lightBanner">
  <button class="collection-banner collection-banner-light" data-view="meals" bindtap="switchView">
    <view class="collection-icon" aria-hidden="true">🥗</view>
    <view class="collection-copy">
      <view class="collection-title">{{title}}</view>
      <view class="collection-description">{{description}}</view>
    </view>
    <text class="collection-arrow" aria-hidden="true">›</text>
  </button>
</template>

<template name="homeFeature">
  <navigator wx:if="{{recipe}}" class="feature-banner {{recipe.image ? 'feature-with-photo' : ''}}" url="/pages/recipe/index?id={{recipe.id}}" hover-class="feature-tap" aria-label="{{recipe.name + '，看做法'}}">
    <recipe-cover wx:if="{{recipe.image}}" class="feature-image" src="{{recipe.image}}"/>
    <view class="banner-caption">
      <text class="feature-badge">{{isRecommended ? '今日灵感' : '快手菜'}}</text>
      <view class="feature-title">{{recipe.name}}</view>
      <view class="feature-meta">{{recipe.minutes}} 分钟 · {{recipe.difficulty}}</view>
    </view>
  </navigator>
</template>

<view class="theme-page theme-{{themeId}}">
<view class="screen has-nav {{view === 'match' ? 'home-screen' : ''}}">
  <block wx:if="{{view === 'match'}}">
    <view class="home-greeting">
      <view class="home-title-row">
        <view class="home-heading-copy">
          <view class="greeting-quote">{{greeting.quoteText}}</view>
          <view class="home-title">今天想吃点什么？</view>
        </view>
        <view class="home-wok" aria-hidden="true">
          <view class="wok-steam"></view>
          <view class="wok-vegetables"><view></view><view></view><view></view></view>
          <view class="wok-pan"></view>
        </view>
      </view>
      <button class="recipe-search home-search" bindtap="openRecipeSearch">
        <view class="search-mark" aria-hidden="true"></view>
        <text>搜索菜谱、食材</text>
      </button>
    </view>
    <template is="homeFeature" data="{{recipe: featured || quickRecipe, isRecommended: !!featured}}"/>
    <view class="home-shortcuts">
      <button class="home-shortcut" bindtap="openRecommendations">
        <view class="shortcut-icon shortcut-ai"><image src="/assets/icon-sparkles.svg" aria-hidden="true"/></view>
        <text>问问 AI</text>
      </button>
      <button class="home-shortcut" bindtap="openFridge">
        <view class="shortcut-icon shortcut-fridge"><image src="/assets/icon-fridge.svg" aria-hidden="true"/></view>
        <text>我的冰箱</text>
      </button>
      <button class="home-shortcut" bindtap="showShortcutUnavailable">
        <view class="shortcut-icon shortcut-camera"><image src="/assets/icon-camera.svg" aria-hidden="true"/></view>
        <text>拍照识菜</text>
      </button>
      <button class="home-shortcut" bindtap="showShortcutUnavailable">
        <view class="shortcut-icon shortcut-random"><image src="/assets/icon-shuffle.svg" aria-hidden="true"/></view>
        <text>随机吃</text>
      </button>
    </view>

    <view class="home-fridge">
      <view class="row home-fridge-heading">
        <text class="section">冰箱里能做什么</text>
        <button wx:if="{{selected.length}}" class="more-recipes-link home-fridge-link" bindtap="openFridgeMatches">浏览更多 <text class="more-recipes-arrow" aria-hidden="true">›</text></button>
      </view>
      <view wx:if="{{selected.length}}" class="home-fridge-description">根据你登记的食材，找到今天的好选择</view>
      <view wx:if="{{homeMatches.length}}" class="discovery-grid home-match-grid">
        <template wx:for="{{homeMatches}}" wx:key="id" is="discoveryTile" data="{{recipe: item, showStock: true}}"/>
      </view>
      <view wx:else class="home-fridge-empty">
        <text>{{selected.length ? (featured ? '补充冰箱食材，看看还能做什么。' : '目前的食材还凑不出一道合适的菜。') : '选几样手边食材，看看今晚能做什么。'}}</text>
        <button class="link" bindtap="openFridge">{{selected.length ? '补充食材' : '添加食材'}}</button>
      </view>
    </view>
    <view wx:if="{{suggestedRecipes.length}}" class="home-inspiration">
      <view class="row home-fridge-heading">
        <text class="section">猜你喜欢</text>
        <button class="more-recipes-link home-fridge-link" bindtap="openAllRecipes">全部菜谱 <text class="more-recipes-arrow" aria-hidden="true">›</text></button>
      </view>
      <view class="discovery-grid home-match-grid">
        <template wx:for="{{suggestedRecipes}}" wx:key="id" is="discoveryTile" data="{{recipe: item, showStock: !!selected.length}}"/>
      </view>
    </view>
    <view class="home-inspiration">
      <view class="row home-fridge-heading">
        <text class="section">轻食灵感</text>
        <button class="more-recipes-link home-fridge-link" data-view="meals" bindtap="switchView">更多 <text class="more-recipes-arrow" aria-hidden="true">›</text></button>
      </view>
      <navigator wx:if="{{lightInspiration}}" class="collection-banner collection-banner-light" url="/pages/recipe/index?id={{lightInspiration.id}}" hover-class="pressed">
        <recipe-cover class="collection-photo" src="{{lightInspiration.image}}" lazy="{{true}}"/>
        <view class="collection-copy">
          <view class="collection-title">{{lightInspiration.name}}</view>
          <view class="collection-description">{{lightInspiration.minutes}} 分钟 · {{lightInspiration.difficulty}}</view>
        </view>
        <text class="collection-arrow" aria-hidden="true">›</text>
      </navigator>
    </view>
  </block>

  <block wx:elif="{{view === 'library'}}">
    <view class="library-header">
      <view class="library-eyebrow">好味道，慢慢发现</view>
      <view class="library-title">菜谱灵感</view>
    </view>
    <view class="recipe-search library-search">
      <view class="search-mark" aria-hidden="true"></view>
      <input class="recipe-search-input" value="{{librarySearch}}" focus="{{librarySearchFocused}}" bindinput="searchLibrary" bindblur="blurLibrarySearch" confirm-type="search" placeholder="搜菜名或食材"/>
      <button wx:if="{{librarySearch}}" class="link" bindtap="clearLibrarySearch">清除</button>
    </view>
    <view class="row library-toolbar">
      <text class="section">{{librarySearch || categoryIndex ? '找到 ' : '共 '}}{{results.length}} 道菜</text>
      <picker class="library-category-picker" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="changeCategory" aria-label="菜谱分类，当前{{categories[categoryIndex]}}">
        <view class="library-category-label {{categoryIndex ? 'library-category-active' : ''}}">
          <text>{{categories[categoryIndex]}}</text>
          <view class="library-category-arrow" aria-hidden="true"></view>
        </view>
      </picker>
    </view>
    <view wx:if="{{!results.length}}" class="empty">没有找到符合条件的菜谱。</view>
    <view wx:else class="discovery-grid library-grid">
      <template wx:for="{{libraryCards}}" wx:key="id" is="discoveryTile" data="{{recipe: item}}"/>
    </view>
    <button wx:if="{{libraryCards.length < results.length}}" class="link library-load-more" bindtap="loadMoreRecipes">加载更多</button>
    <view class="home-inspiration">
      <view class="row home-fridge-heading"><text class="section">轻食搭配</text></view>
      <template is="lightBanner" data="{{title: '一人食 · 清爽轻食', description: '看看主食和配菜怎么搭'}}"/>
    </view>
  </block>

  <light-meals wx:elif="{{view === 'meals'}}" inventory="{{selected}}" inventory-ready="{{inventoryReady}}"/>

  <block wx:elif="{{view === 'profile'}}">
    <view class="row profile-header">
      <view>
        <view class="profile-eyebrow">每一顿饭，都值得被记住</view>
        <view class="profile-title">我的厨房</view>
      </view>
      <button class="profile-settings" bindtap="openProfileThemes" aria-label="主题设置"><text aria-hidden="true">⚙︎</text></button>
    </view>
    <view class="profile-head">
      <view class="profile-avatar" aria-hidden="true">👩🏻‍🍳</view>
      <view class="profile-copy">
        <view class="profile-name">厨房里的美好日常</view>
        <view class="profile-note">{{selected.length ? '手边有 ' + fridgeSummary.count + ' 种食材' : '冰箱还没登记食材'}}<text wx:if="{{fridgeSummary.staples}}"> · {{fridgeSummary.staples}} 样常备</text></view>
      </view>
    </view>
    <view class="profile-stats">
      <navigator class="profile-stat" url="/pages/records/index?type=favorites" hover-class="card-pressed"><text class="stat-count">{{favorites.length}}</text>我的收藏</navigator>
      <navigator class="profile-stat" url="/pages/records/index?type=history" hover-class="card-pressed"><text class="stat-count">{{history.length}}</text>浏览历史</navigator>
      <navigator class="profile-stat" url="/pages/records/index?type=cooked" hover-class="card-pressed"><text class="stat-count">{{cooked.length}}</text>做过的菜</navigator>
    </view>
    <view class="profile-links">
      <button class="profile-row" bindtap="openFridge"><image src="/assets/icon-fridge.svg" aria-hidden="true"/>冰箱食材<text class="profile-arrow">›</text></button>
      <navigator class="profile-row" url="/pages/shopping/index" hover-class="pressed"><image src="/assets/icon-cart.svg" aria-hidden="true"/>采购清单<text class="profile-arrow">›</text></navigator>
    </view>
    <view id="profile-themes" class="profile-themes">
      <view class="profile-themes-title">主题</view>
      <view class="theme-options">
        <button wx:for="{{themeOptions}}" wx:key="id" class="theme-option {{themeId === item.id ? 'theme-option-selected' : ''}}" data-id="{{item.id}}" bindtap="changeTheme" aria-pressed="{{themeId === item.id}}">
          <view class="theme-swatch" style="background: {{item.background}}" aria-hidden="true">
            <view class="theme-swatch-dot" style="background: {{item.accent}}"></view>
          </view>
          <text>{{item.name}}</text>
          <text wx:if="{{themeId === item.id}}" class="theme-option-check" aria-hidden="true">✓</text>
        </button>
      </view>
    </view>
  </block>

</view>

<view class="bottom-nav main-nav">
  <view class="nav-inner">
    <button class="nav-item {{view === 'match' ? 'nav-current' : ''}}" data-view="match" bindtap="switchView"><image src="/assets/icon-home.svg" aria-hidden="true"/>首页</button>
    <button class="nav-item {{view === 'library' ? 'nav-current' : ''}}" data-view="library" bindtap="switchView"><image src="/assets/icon-cookbook.svg" aria-hidden="true"/>菜谱</button>
    <button class="nav-item {{view === 'meals' ? 'nav-current' : ''}}" data-view="meals" bindtap="switchView"><image src="/assets/icon-light-meal.svg" aria-hidden="true"/>轻食</button>
    <button class="nav-item {{view === 'profile' ? 'nav-current' : ''}}" data-view="profile" bindtap="switchView"><image src="/assets/icon-profile.svg" aria-hidden="true"/>我的</button>
  </view>
</view>
</view>

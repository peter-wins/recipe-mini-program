.privacy-page { min-height: 100vh; box-sizing: border-box; }
.privacy-inner { max-width: 900rpx; margin: 0 auto; padding: 40rpx var(--sp-8, 32rpx) 80rpx; box-sizing: border-box; }

.privacy-head { padding: 12rpx 8rpx 28rpx; }
.privacy-title { color: var(--theme-text, #4e342c); font-size: var(--fs-2xl, 44rpx); font-weight: 700; line-height: 1.25; }
.privacy-updated { margin-top: 10rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); }

.privacy-card {
  margin-top: 20rpx;
  padding: 26rpx 28rpx 28rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.privacy-section-title { color: var(--theme-text, #4e342c); font-size: var(--fs-lg, 32rpx); font-weight: 700; }
.privacy-hint { margin-top: 8rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); }

.privacy-item { margin-top: 22rpx; }
.privacy-item-title { color: var(--theme-accent-text, #994017); font-size: var(--fs-md, 28rpx); font-weight: 700; }
.privacy-item-body { margin-top: 6rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); line-height: 1.65; }

.privacy-note {
  position: relative;
  margin-top: 14rpx;
  padding-left: 24rpx;
  color: var(--theme-muted, #75665e);
  font-size: var(--fs-sm, 24rpx);
  line-height: 1.65;
}
.privacy-note::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--theme-accent-text, #994017);
}

.privacy-para { margin-top: 12rpx; color: var(--theme-muted, #75665e); font-size: var(--fs-sm, 24rpx); line-height: 1.7; }


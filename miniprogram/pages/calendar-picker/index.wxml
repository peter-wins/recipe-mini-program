<view class="theme-page theme-{{themeId}}">
  <view wx:if="{{errorMessage}}" class="screen empty">{{errorMessage}}</view>
  <block wx:elif="{{dateLabel}}">
    <view class="screen calendar-picker-screen">
      <view class="row calendar-picker-heading">
        <view class="calendar-picker-context">
          <text class="section">{{label}}</text>
          <text class="subtle">{{dateLabel}}</text>
        </view>
        <button class="link calendar-picker-pairings" bindtap="openMealPairings">去搭配 <text aria-hidden="true">›</text></button>
      </view>
      <view wx:if="{{replacing}}" class="subtle calendar-picker-current">当前安排 · {{currentTitle}}</view>
      <recipe-picker id="recipe-picker" initial="{{selected}}" confirm-text="{{(replacing ? '替换' : '加入') + label}}" busy="{{saving}}" bind:confirm="onPickerConfirm"/>
    </view>
  </block>
</view>

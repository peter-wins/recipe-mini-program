@import "../../styles/fridge-preview.wxss";
@import "../../styles/recipe-card.wxss";

.recommend-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--theme-page-bg, #fff8f0);
}
.recommend-nav-bar {
  position: relative;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.recommend-nav-back {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  padding: 0;
  background: transparent;
}
.recommend-nav-chevron {
  width: 14rpx;
  height: 14rpx;
  border-bottom: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  transform: rotate(45deg);
}
.recommend-nav-icon { flex-shrink: 0; width: 32rpx; height: 32rpx; }
.recommend-nav-title {
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recommend-reset {
  padding: 0 4rpx 0 8rpx;
  font-size: 24rpx;
  line-height: 60rpx;
}
.recommend-reset text { font-size: 32rpx; vertical-align: middle; }
.recommend-intro { margin: 4rpx 0 24rpx; }
.recommend-modes, .recommend-times, .recommend-tastes, .recommend-people { display: flex; gap: 12rpx; }
.recommend-modes { margin-bottom: 20rpx; }
.recommend-mode {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 4rpx;
  height: 112rpx;
  border: 2rpx solid var(--theme-border, #eadfd4);
  border-radius: 24rpx;
  background: var(--theme-surface, #fff);
  color: var(--theme-muted, #75665e);
  font-size: 23rpx;
  line-height: 1.25;
}
.recommend-icon { flex-shrink: 0; display: block; width: 32rpx; height: 32rpx; }
.recommend-chat-icon {
  box-sizing: border-box;
  position: relative;
  width: 28rpx;
  height: 26rpx;
  margin: 2rpx 0 4rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.recommend-chat-icon::after {
  position: absolute;
  bottom: -3rpx;
  left: 1rpx;
  width: 7rpx;
  height: 6rpx;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-28deg);
  content: '';
}
.recommend-panel {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.recommend-label { margin: 20rpx 0 10rpx; color: var(--theme-muted, #75665e); font-size: 26rpx; }
.recommend-people { align-items: center; gap: 16rpx; font-size: 28rpx; font-weight: 650; }
.recommend-people text { min-width: 64rpx; text-align: center; }
.recommend-option, .recommend-step {
  background: var(--theme-neutral, #f5eee6);
  color: var(--theme-text, #5d4037);
  line-height: 58rpx;
}
.recommend-option {
  min-width: 0;
  padding: 0 18rpx;
  border: 2rpx solid transparent;
  font-size: 25rpx;
}
.recommend-times .recommend-option { flex: 1; padding: 0 4rpx; border-radius: 20rpx; }
.recommend-time-selected { background: var(--theme-accent-text, #955e39); color: #fff; }
.recommend-tastes { flex-wrap: wrap; }
.recommend-tastes .recommend-option { border-radius: 999rpx; }
.recommend-mode-selected,
.recommend-tastes .recommend-taste-selected {
  border-color: var(--theme-selected-border, #f2b28a);
  background: var(--theme-selected, #ffe8d5);
  color: var(--theme-accent-text, #994017);
}
.recommend-step { width: 58rpx; padding: 0; border-radius: 16rpx; font-size: 32rpx; }
.recommend-step[disabled] { opacity: .45; }
.recommend-input {
  box-sizing: border-box;
  width: 100%;
  height: 100rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid var(--theme-border, #e6dcd1);
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
}
.recommend-hint { margin-top: 10rpx; }
.recommend-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 0 20rpx;
}
.recommend-submit .recommend-icon { filter: brightness(.55); }
.recommend-results { margin-top: 28rpx; }
.recommend-result-note { margin-top: 6rpx; overflow-wrap: anywhere; }
.recommend-results .discovery-grid { margin-top: 16rpx; }

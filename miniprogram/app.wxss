page {
  background: #FFF8F0;
  color: #5D4037;
  font-family: system-ui, sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

/* ---------- 布局骨架 ---------- */
.screen {
  box-sizing: border-box;
  max-width: 900rpx;
  margin: 0 auto;
  padding: 20rpx 32rpx 64rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.has-nav {
  padding-bottom: 180rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.page-head {
  box-sizing: border-box;
  padding: 22rpx 0 14rpx;
}
.headline {
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 2rpx;
}
.page-head > .subtle { margin-top: 16rpx; }
.subtle, .recipe-note, .recipe-aside, .group-label { color: #75665e; font-size: 26rpx; }

.row, .list-heading, .recipe-aside {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.row, .list-heading { justify-content: space-between; }

/* ---------- 按钮 ---------- */
button {
  box-sizing: border-box;
  margin: 0;
  padding: 0 28rpx;
  color: inherit;
  font-size: 28rpx;
  line-height: 76rpx;
}
button::after { border: 0; }
.primary, .link, .chip { border-radius: 999rpx; }
.primary {
  background: #FF8A3D;
  color: #43251b;
  font-weight: 650;
}
.link {
  background: transparent;
  color: #994017;
  padding: 0 16rpx;
  line-height: 76rpx;
  flex-shrink: 0;
  font-weight: 600;
}

/* ---------- 筛选器 ---------- */
.actions, .ingredients { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; }
.chevron { margin-left: 6rpx; color: #a57455; }

/* ---------- 列表标题 ---------- */
.list-heading { margin-top: 36rpx; padding-bottom: 16rpx; }
.section { font-weight: 750; font-size: 34rpx; color: #5D4037; }
.empty { color: #75665e; padding: 32rpx 0; text-align: center; }

/* ---------- 菜谱卡片 ---------- */
.recipe-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(180, 110, 50, 0.08);
}
.card-pressed { background: #fff3e8; }
.pressed { background: #fff3e8; }
.dish-thumb {
  flex-shrink: 0;
  width: 104rpx;
  height: 88rpx;
  overflow: hidden;
  border-radius: 12rpx;
}
.recipe-text { min-width: 0; flex: 1; }
.recipe-name { font-weight: 700; font-size: 34rpx; }
.recipe-note { margin-top: 8rpx; }
.recipe-aside { flex-shrink: 0; gap: 10rpx; font-size: 26rpx; }
.arrow { font-size: 38rpx; line-height: 1; color: #a57455; }
.missing { color: #994017; }

/* 兼容旧列表行（采购等） */
.recipe-row, .purchase-row {
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(180, 110, 50, 0.08);
}
.purchase-row { margin-top: 18rpx; }

/* ---------- 食材 chips ---------- */
.ingredients { margin-top: 18rpx; }
.chip {
  background: #fff;
  border: 1rpx solid #f0e4d8;
  line-height: 66rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
  color: #5D4037;
  box-shadow: 0 4rpx 10rpx rgba(180, 110, 50, 0.05);
}
.chosen {
  background: #ffe8d5;
  border-color: #f2b28a;
  color: #994017;
  font-weight: 600;
}
.ingredient-group { margin-top: 34rpx; }
.ingredient-group .section, .group-label { font-size: 28rpx; font-weight: 700; color: #5D4037; }
.group-label { display: inline-block; padding-left: 18rpx; border-left: 6rpx solid #ff8a3d; line-height: 1.4; }
.actions { margin-top: 18rpx; }

/* ---------- 缺食材提示 ---------- */
.shortage {
  margin-top: 20rpx;
  border-radius: 24rpx;
  background: #fff4ec;
  border: 1rpx solid #ffd9ba;
  padding: 26rpx 28rpx;
}
.shortage .section { font-size: 30rpx; color: #994017; }
.shortage .primary { line-height: 64rpx; padding: 0 26rpx; font-size: 26rpx; }
.shortage .link { line-height: 64rpx; font-size: 26rpx; }

/* ---------- 详情：食材 / 步骤 ---------- */
.group {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(180, 110, 50, 0.06);
}
.ingredient { margin-top: 12rpx; }
.quantity { text-align: right; flex-shrink: 0; color: #75665e; }
.step {
  display: flex;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(180, 110, 50, 0.06);
}
.step-number {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffecdf;
  color: #994017;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  line-height: 48rpx;
  margin-top: 4rpx;
}
.step-content { flex: 1; line-height: 1.7; }
.step-title { font-size: 31rpx; font-weight: 700; margin-bottom: 6rpx; color: #5D4037; }

/* ---------- 悬浮底部导航 ---------- */
.bottom-nav {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 10;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(150, 80, 30, 0.18);
  padding: 10rpx;
  box-sizing: border-box;
}
.nav-inner { display: flex; max-width: 900rpx; margin: 0 auto; gap: 6rpx; }
.nav-item {
  flex: 1;
  text-align: center;
  box-sizing: border-box;
  line-height: 84rpx;
  font-size: 28rpx;
  padding: 0;
  border-radius: 32rpx;
  background: transparent;
  color: #8a7a68;
}
.nav-current {
  background: #ffe8d5;
  color: #994017;
  font-weight: 700;
}

.feature-image, .detail-image { display: block; width: 100%; }
.feature-tap { opacity: .85; }
.recipe-bar { display: flex; align-items: center; gap: 14rpx; }
.recipe-bar .link { flex: 0 0 144rpx; text-align: center; }
.recipe-bar .primary { flex: 1; }
.cooking-progress { margin-bottom: 10rpx; color: #994017; font-size: 26rpx; }
.cooking-step { font-size: 34rpx; }
.cooking-controls { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.cooking-controls button[disabled] { background: transparent; color: #897f72; }

/* ---------- 字号阶梯（P1-3）----------
 * 收成 7 档，替代此前散落的 27 种字号。
 * xs 仅角标徽标 / sm 辅助说明 / md 正文列表 / lg 卡片标题
 * xl 区块标题 / 2xl 次级页标题 / 3xl 一级页标题
 */
page {
  --fs-xs: 22rpx;
  --fs-sm: 24rpx;
  --fs-md: 28rpx;
  --fs-lg: 32rpx;
  --fs-xl: 36rpx;
  --fs-2xl: 44rpx;
  --fs-3xl: 52rpx;

  background: #FFF8F0;
  color: var(--theme-text, #5D4037);
  font-family: system-ui, sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

/* ---------- 布局骨架 ---------- */
.screen {
  box-sizing: border-box;
  max-width: 900rpx;
  margin: 0 auto;
  padding: 20rpx 32rpx 64rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.has-nav {
  padding-bottom: 180rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.page-head {
  box-sizing: border-box;
  padding: 22rpx 0 14rpx;
}
.headline {
  font-size: var(--fs-3xl, 52rpx);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
}
.page-head > .subtle { margin-top: 16rpx; }
.subtle, .recipe-note, .recipe-aside, .group-label { color: var(--theme-muted, #75665e); font-size: var(--fs-md, 28rpx); }

.row, .list-heading, .recipe-aside {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.row, .list-heading { justify-content: space-between; }

/* ---------- 按钮（规范第8条：主要/次要/文字/图标/危险 五类） ---------- */
/* 语义状态色（规范第5条：警告/删除/成功/禁用独立变量，不套主题色） */
page, .theme-page {
  --state-danger: #c04040;
  --state-danger-soft: #fbeaea;
  --state-warning: #b5741a;
  --state-warning-soft: #fdf1dc;
  --state-success: #397454;
  --state-success-soft: #e7f2ea;
  --state-disabled: #b9aca2;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0 28rpx;
  color: inherit;
  font-size: var(--fs-md, 28rpx);
  line-height: 76rpx;
  min-height: 88rpx; /* 统一最小点击区 */
}
button::after { border: 0; }
button[disabled] { opacity: .55; color: var(--state-disabled, #b9aca2); }

.primary, .secondary, .text-btn, .icon-btn, .danger-btn, .link, .chip {
  border-radius: 999rpx;
  transition: opacity .15s, transform .15s;
}
.primary, .secondary, .danger-btn { padding: 0 32rpx; font-weight: 600; }

/* 主要操作：主题主色 */
.primary {
  background: var(--theme-accent, #FF8A3D);
  color: var(--theme-text, #43251b);
}
/* 次要操作：主题浅底 + 主题文字 */
.secondary {
  background: var(--theme-soft, #fff0e5);
  color: var(--theme-accent-text, #994017);
  border: 1rpx solid var(--theme-selected-border, #d9b59a);
}
/* 文字操作：透明底，主题文字（兼容既有 .link） */
.text-btn, .link {
  background: transparent;
  color: var(--theme-accent-text, #994017);
  padding: 0 16rpx;
  flex-shrink: 0;
  font-weight: 600;
}
.link { line-height: 76rpx; }
/* 图标按钮：正方形点击区 */
.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  background: transparent;
}
.icon-btn image { width: 36rpx; height: 36rpx; }
/* 危险操作：独立语义色，不随主题 */
.danger-btn {
  background: var(--state-danger-soft, #fbeaea);
  color: var(--state-danger, #c04040);
}
/* 统一点击反馈 */
.primary.hover, .secondary.hover, .danger-btn.hover, .icon-btn.hover { opacity: .75; transform: scale(.98); }
.text-btn.hover, .link.hover { opacity: .6; }

/* ---------- 筛选器 ---------- */
.actions, .ingredients { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; }
.chevron { margin-left: 6rpx; color: var(--theme-accent-text, #a57455); }

/* ---------- 列表标题 ---------- */
.list-heading { margin-top: 36rpx; padding-bottom: 16rpx; }
.section { font-weight: 700; font-size: var(--fs-xl, 36rpx); color: var(--theme-text, #5D4037); }
.empty { color: var(--theme-muted, #75665e); font-size: var(--fs-md, 28rpx); line-height: 1.6; padding: 48rpx 0; text-align: center; }

/* ---------- 菜谱卡片 ---------- */
.recipe-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.card-pressed { background: var(--theme-soft, #fff3e8); }
.pressed { background: var(--theme-soft, #fff3e8); }
.dish-thumb {
  flex-shrink: 0;
  width: 104rpx;
  height: 88rpx;
  overflow: hidden;
  border-radius: 12rpx;
}
.recipe-text { min-width: 0; flex: 1; }
.recipe-name { font-weight: 700; font-size: var(--fs-xl, 36rpx); }
.recipe-note { margin-top: 8rpx; }
.recipe-aside { flex-shrink: 0; gap: 10rpx; font-size: var(--fs-md, 28rpx); }
.arrow { font-size: var(--fs-xl, 36rpx); line-height: 1; color: var(--theme-accent-text, #a57455); }
.missing { color: var(--theme-accent-text, #994017); }

/* 兼容旧列表行（采购等） */
.recipe-row, .purchase-row {
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.purchase-row { margin-top: 18rpx; }

/* ---------- 食材 chips ---------- */
.ingredients { margin-top: 18rpx; }
.chip {
  background: var(--theme-surface, #fff);
  border: 1rpx solid var(--theme-border, #f0e4d8);
  line-height: 66rpx;
  padding: 0 28rpx;
  font-size: var(--fs-md, 28rpx);
  color: var(--theme-text, #5D4037);
}
.chosen {
  background: var(--theme-selected, #ffe8d5);
  border-color: var(--theme-selected-border, #f2b28a);
  color: var(--theme-accent-text, #994017);
  font-weight: 600;
}
.ingredient-group { margin-top: 34rpx; }
.ingredient-group .section, .group-label { font-size: var(--fs-md, 28rpx); font-weight: 700; color: var(--theme-text, #5D4037); }
.group-label { display: inline-block; padding-left: 18rpx; border-left: 6rpx solid var(--theme-accent, #ff8a3d); line-height: 1.4; }
.actions { margin-top: 18rpx; }

/* ---------- 缺食材提示 ---------- */
.shortage {
  margin-top: 20rpx;
  border-radius: 24rpx;
  background: var(--theme-soft, #fff4ec);
  border: 1rpx solid var(--theme-border, #ffd9ba);
  padding: 26rpx 28rpx;
}
.shortage .section { font-size: var(--fs-lg, 32rpx); color: var(--theme-accent-text, #994017); }
.shortage .primary { line-height: 64rpx; padding: 0 26rpx; font-size: var(--fs-md, 28rpx); }
.shortage .link { line-height: 64rpx; font-size: var(--fs-md, 28rpx); }

/* ---------- 详情：食材 / 步骤 ---------- */
.group {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: 20rpx;
  background: var(--theme-surface, #fff);
}
.ingredient { margin-top: 12rpx; }
.quantity { text-align: right; flex-shrink: 0; color: var(--theme-muted, #75665e); }
.step {
  display: flex;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  margin-top: 18rpx;
  border: 1rpx solid var(--theme-border, #f0e4d8);
  border-radius: var(--card-radius, 28rpx);
  background: var(--theme-surface, #fff);
}
.step-number {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--theme-selected, #ffecdf);
  color: var(--theme-accent-text, #994017);
  font-size: var(--fs-md, 28rpx);
  font-weight: 700;
  text-align: center;
  line-height: 48rpx;
  margin-top: 4rpx;
}
.step-content { flex: 1; line-height: 1.7; }
.step-title { font-size: var(--fs-lg, 32rpx); font-weight: 700; margin-bottom: 6rpx; color: var(--theme-text, #5D4037); }

/* ---------- 悬浮底部导航 ---------- */
.bottom-nav {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 10;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(150, 80, 30, 0.18);
  padding: 10rpx;
  box-sizing: border-box;
}
.nav-inner { display: flex; max-width: 900rpx; margin: 0 auto; gap: 6rpx; }
.nav-item {
  flex: 1;
  text-align: center;
  box-sizing: border-box;
  line-height: 84rpx;
  font-size: var(--fs-md, 28rpx);
  padding: 0;
  border-radius: 32rpx;
  background: transparent;
  color: var(--theme-muted, #75665e);
}
.nav-current {
  background: var(--theme-selected, #ffe8d5);
  color: var(--theme-accent-text, #994017);
  font-weight: 700;
}

.feature-image, .detail-image { display: block; width: 100%; }
.feature-tap { opacity: .85; }
.recipe-bar { display: flex; align-items: center; gap: 14rpx; }
.recipe-bar .link { flex: 0 0 144rpx; text-align: center; }
.recipe-bar .primary { flex: 1; }
.cooking-progress { margin-bottom: 10rpx; color: var(--theme-accent-text, #994017); font-size: var(--fs-md, 28rpx); }
.cooking-step { font-size: var(--fs-xl, 36rpx); }
.cooking-controls { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.cooking-controls button[disabled] { background: transparent; color: #897f72; }

.theme-page {
  --theme-page-bg: #fff8f0;
  --theme-text: #5d4037;
  --theme-muted: #75665e;
  --theme-border: #eadfd4;
  --theme-accent: #ff8a3d;
  --theme-accent-text: #994017;
  --theme-accent-solid: #c24610;
  --theme-soft: #fff0e5;
  --theme-selected: #fbecdc;
  --theme-selected-border: #d9b59a;
  --theme-placeholder: #f4e9de;
  --theme-neutral: #f1e6d9;
  --theme-surface: #fff;
  --theme-tint-1: #f2e6d2;
  --theme-tint-2: #e4ecdf;
  --theme-tint-3: #f2e6dd;
  --theme-tint-4: #eee6ec;
  --card-radius: 28rpx;
  --stock-ready: #397454;
  --stock-missing: #c04040;
  --theme-accent-icon: brightness(.68) sepia(.8) saturate(4);
  min-height: 100vh;
  background: var(--theme-page-bg);
  color: var(--theme-text);
}
.theme-green {
  --theme-page-bg: #f2f7ee;
  --theme-text: #233b2a;
  --theme-muted: #4e6252;
  --theme-border: #dae6d7;
  --theme-accent: #a6c89b;
  --theme-accent-text: #315b37;
  --theme-accent-solid: #46703f;
  --theme-soft: #f3f8f0;
  --theme-selected: #dfedd9;
  --theme-selected-border: #a9c5a1;
  --theme-placeholder: #e4ede0;
  --theme-neutral: #edf2eb;
  --theme-tint-1: #e6efdf;
  --theme-tint-2: #dcead6;
  --theme-tint-3: #e9efe2;
  --theme-tint-4: #e2ebe6;
  --theme-accent-icon: grayscale(1) brightness(.65) sepia(1) hue-rotate(58deg) saturate(2);
}
.theme-blue {
  --theme-page-bg: #f0f5fb;
  --theme-text: #233951;
  --theme-muted: #4e6280;
  --theme-border: #d6e3ef;
  --theme-accent: #9abbdf;
  --theme-accent-text: #30577e;
  --theme-accent-solid: #35618e;
  --theme-soft: #f3f7fc;
  --theme-selected: #dceafa;
  --theme-selected-border: #a7bfdc;
  --theme-placeholder: #e0eaf5;
  --theme-neutral: #eaf0f7;
  --theme-tint-1: #e2ecf7;
  --theme-tint-2: #dceaf5;
  --theme-tint-3: #e6eef8;
  --theme-tint-4: #e4e9f6;
  --theme-accent-icon: grayscale(1) brightness(.65) sepia(1) hue-rotate(158deg) saturate(3);
}
